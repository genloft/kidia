---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="Kidia - Galería del Laboratorio" description="Creaciones de otros inventores e inventoras de Kidia, moderadas antes de publicarse.">
  <Header />
  <main class="gal-container">
    <div class="gal-header">
      <h1>Galería del Laboratorio</h1>
      <p>Creaciones de otros inventores e inventoras, revisadas por la Dra. Vael antes de aparecer aquí.</p>
    </div>
    <div id="gal-grid" class="gal-grid"></div>
    <p id="gal-empty" class="gal-empty hidden">Todavía no hay creaciones publicadas. ¡Sé el primero o la primera!</p>
  </main>
</Layout>

<script>
  import { UnidadService, type ChildArtifact } from '../../lib/unidad-service';

  const grid = document.getElementById('gal-grid') as HTMLElement;
  const emptyMsg = document.getElementById('gal-empty') as HTMLElement;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function renderCard(artefacto: ChildArtifact): HTMLElement {
    const card = el('div', 'gal-card');
    card.appendChild(el('span', 'gal-card-autor', UnidadService.seudonimoPara(artefacto.child_id)));
    const titulo = artefacto.contenido?.tituloArtefacto || artefacto.tipo;
    card.appendChild(el('h3', 'gal-card-titulo', String(titulo)));
    card.appendChild(el('span', 'gal-card-unidad', `Unidad ${artefacto.unidad_id}`));
    return card;
  }

  async function load() {
    const aprobados = await UnidadService.getGaleriaAprobada();
    grid.innerHTML = '';
    if (aprobados.length === 0) {
      emptyMsg.classList.remove('hidden');
      return;
    }
    emptyMsg.classList.add('hidden');
    aprobados.forEach(a => grid.appendChild(renderCard(a)));
  }

  load();
</script>

<style>
  .gal-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .gal-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .gal-header h1 {
    font-size: clamp(2rem, 3vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .gal-header p {
    color: #94a3b8;
    max-width: 560px;
    margin: 0 auto;
  }

  .gal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .gal-card {
    background: var(--color-surface, #18181b);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.25rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .gal-card-autor {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .gal-card-titulo {
    font-size: 1.15rem;
    margin: 0;
    color: #f8fafc;
  }

  .gal-card-unidad {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .gal-empty {
    text-align: center;
    color: #94a3b8;
    padding: 3rem 0;
  }

  .hidden {
    display: none;
  }
</style>
