---
// Misión especial de cierre de zona: reúne una mini-tarea por competencia.
// Versión simplificada (checklist guiado por Vael) — no reconstruye cada
// mecánica de la zona en miniatura, evita duplicar los 4 widgets de esa
// zona para una pantalla que ya de por sí no se presenta como examen.
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Friend from '../../../components/Friend.astro';
import { loadMisionesEspeciales, getMisionEspecialById } from '../../../lib/scenario-loader';

export async function getStaticPaths() {
  const misiones = await loadMisionesEspeciales('8-9');
  return misiones.map(m => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const mision = await getMisionEspecialById(id || '');

if (!mision) {
  return Astro.redirect('/404');
}
---

<Layout title={`Kidia - ${mision.titulo}`} description={mision.introVael} showFooter={false}>
  <Header />
  <main class="me-layout" data-mision-id={mision.id}>
    <div class="me-header">
      <Friend mode="avatar" state="idle" />
      <div>
        <span class="me-zona-badge">{mision.zona}</span>
        <h1 class="me-titulo">{mision.titulo}</h1>
      </div>
      <div id="me-listen-slot" class="me-listen-slot"></div>
    </div>

    <p class="me-intro">{mision.introVael}</p>

    <div class="me-lista" id="me-lista">
      {mision.miniTareas.map(t => (
        <div class="me-tarea" data-tarea-id={t.id}>
          <div class="me-tarea-info">
            <strong>{t.nombre}</strong>
            <p>{t.descripcion}</p>
          </div>
          <button type="button" class="btn btn-secondary me-check">Hecho ✓</button>
        </div>
      ))}
    </div>

    <div id="me-cierre" class="me-cierre hidden">
      <p class="me-cierre-texto">{mision.cierreVael}</p>
      <a href="/mapa" class="btn btn-primary">Volver al Mapa</a>
    </div>
  </main>

  <script>
    import { storage, syncWithCloud } from '../../../lib/storage-simple';
    import { requireActiveChild } from '../../../lib/require-auth';
    import { createReadAloudButton, readableText } from '../../../lib/speech';

    const listenSlot = document.getElementById('me-listen-slot');
    if (listenSlot) {
      const btn = createReadAloudButton(() => {
        const layout = document.querySelector('.me-layout') as HTMLElement;
        return layout ? readableText(layout) : '';
      }, { label: 'Escuchar', className: 'me-listen-btn' });
      listenSlot.appendChild(btn);
    }

    requireActiveChild().then((allowed) => {
      if (!allowed) return;

      const main = document.querySelector('.me-layout') as HTMLElement;
      const misionId = main?.getAttribute('data-mision-id') || '';
      const tareas = Array.from(document.querySelectorAll('.me-tarea'));
      const cierre = document.getElementById('me-cierre');
      let hechas = 0;

      tareas.forEach(tarea => {
        const btn = tarea.querySelector('.me-check') as HTMLButtonElement;
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          btn.disabled = true;
          btn.textContent = '✓ Hecho';
          tarea.classList.add('done');
          hechas++;
          if (hechas === tareas.length) {
            cierre?.classList.remove('hidden');
            storage.update(s => ({
              ...s,
              completedScenarios: Array.from(new Set([...s.completedScenarios, misionId])),
            }));
            syncWithCloud();
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .me-layout {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .me-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .me-listen-slot {
    margin-left: auto;
  }

  .me-listen-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 99px;
    padding: 0.55rem 1rem;
    color: #e4e4e7;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .me-listen-btn:hover:not(:disabled) {
    border-color: var(--color-primary);
  }

  .me-listen-btn.listening {
    background: rgba(34, 211, 238, 0.12);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .me-listen-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .me-zona-badge {
    display: inline-block;
    background: rgba(139, 92, 246, 0.12);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: 99px;
    margin-bottom: 0.4rem;
  }

  .me-titulo {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0;
  }

  .me-intro {
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .me-lista {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .me-tarea {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-surface, #18181b);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .me-tarea.done {
    border-color: rgba(34, 197, 94, 0.4);
    background: rgba(34, 197, 94, 0.06);
  }

  .me-tarea-info strong {
    display: block;
    color: #f8fafc;
    margin-bottom: 0.25rem;
  }

  .me-tarea-info p {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0;
  }

  .me-cierre {
    text-align: center;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 1.25rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .hidden {
    display: none;
  }
</style>
