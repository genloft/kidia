---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const secciones = [
  {
    icon: '✅',
    title: 'Aceptación de los Términos',
    text: 'Al acceder y utilizar la plataforma Kidia, aceptas estar sujeto a estos términos y condiciones de uso. Si no estás de acuerdo con alguna parte de los términos, te rogamos que no utilices la plataforma.'
  },
  {
    icon: '🎮',
    title: 'Descripción del Servicio',
    text: 'Kidia es una plataforma educativa diseñada para enseñar conceptos de Inteligencia Artificial a menores a través de retos e interacciones guiadas. La herramienta está destinada a un uso lúdico y formativo.'
  },
  {
    icon: '👪',
    title: 'Cuentas de Usuario',
    text: 'Para acceder a ciertas funciones, es necesario crear una cuenta. Recomendamos que las cuentas de los menores sean creadas y supervisadas por un padre, madre o tutor legal. Eres responsable de mantener la confidencialidad de tu contraseña.'
  },
  {
    icon: '🛡️',
    title: 'Uso Aceptable',
    text: 'Te comprometes a utilizar Kidia de manera ética y respetuosa. Está prohibido utilizar la plataforma para generar contenido inapropiado, ofensivo o que vulnere los derechos de otras personas.'
  },
  {
    icon: '📝',
    title: 'Modificaciones',
    text: 'Nos reservamos el derecho a modificar estos términos en cualquier momento. Los cambios significativos serán notificados a los usuarios a través del correo electrónico proporcionado en su cuenta.'
  }
];
---

<Layout title="Términos de Uso - Kidia" description="Términos y condiciones de uso de la plataforma Kidia.">
  <Header />
  <main class="legal-container">
    <div class="legal-header">
      <h1 class="text-gradient">Términos de Uso</h1>
      <span class="pill">Última actualización: {new Date().toLocaleDateString('es-ES')}</span>
    </div>

    <div class="legal-sections">
      {secciones.map((s, i) => (
        <section class="card legal-card">
          <div class="legal-card-icon">{s.icon}</div>
          <div>
            <h2>{i + 1}. {s.title}</h2>
            <p>{s.text}</p>
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .legal-container {
    max-width: 780px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .legal-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .legal-header h1 {
    font-size: 2.75rem;
    margin-bottom: 1rem;
  }

  .legal-sections {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .legal-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .legal-card-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    border-radius: var(--radius-md);
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.2);
  }

  .legal-card h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .legal-card p {
    margin: 0;
    line-height: 1.7;
  }
</style>
