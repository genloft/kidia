---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BadgeGrid from '../components/BadgeGrid.astro';

// El progreso vive en el cliente (localStorage por hijo/a activo): el
// script de abajo importa ProgressService; aquí en SSR no hace falta.
---

<Layout title="Kidia - Colección de Insignias" description="Consulta las insignias que has desbloqueado completando retos de IA en Kidia y descubre cuáles te faltan por conseguir.">
  <Header mode="aventura" />

  <main class="badges-page">
      <div class="page-header">
          <h1>🏆 Colección de Insignias</h1>
          <p>Cada misión que completes te da una insignia. Aquí están todas las de tu tramo de edad.</p>

          <div class="stats-overview">
              <div class="stat-box">
                  <span class="stat-value" id="total-badges">0</span>
                  <span class="stat-label">Desbloqueadas</span>
              </div>
              <div class="stat-box">
                  <span class="stat-value" id="global-rank">Novato</span>
                  <span class="stat-label">Rango Actual</span>
              </div>
          </div>
      </div>

      <BadgeGrid />
  </main>
</Layout>

<script>
    import { ProgressService } from '../lib/progress-service';
    import { requireActiveChild } from '../lib/require-auth';

    let totalReachable = 0;

    function updateStats() {
        const state = ProgressService.getState();
        const earnedCount = state.badges.length;

        (document.getElementById('total-badges') as HTMLElement).innerText = totalReachable ? `${earnedCount} / ${totalReachable}` : `${earnedCount}`;

        // Rangos en proporción a las insignias que este hijo/a puede llegar a ganar
        const ranks = totalReachable > 0
            ? [
                { limit: 0, title: 'Novato' },
                { limit: Math.ceil(totalReachable * 0.25), title: 'Explorador' },
                { limit: Math.ceil(totalReachable * 0.5), title: 'Aprendiz de IA' },
                { limit: Math.ceil(totalReachable * 0.75), title: 'Arquitecto' },
                { limit: totalReachable, title: 'Superinteligencia' },
            ]
            : [{ limit: 0, title: 'Novato' }];

        const currentRank = [...ranks].reverse().find(r => earnedCount >= r.limit) || ranks[0];
        const rankEl = document.getElementById('global-rank') as HTMLElement;
        rankEl.innerText = currentRank.title;
        rankEl.style.color = 'var(--color-primary)';
    }

    window.addEventListener('badges:tramo-ready', (e) => {
        totalReachable = (e as CustomEvent<{ total: number }>).detail?.total || 0;
        updateStats();
    });

    requireActiveChild().then(allowed => {
        if (!allowed) return;
        updateStats();
        window.addEventListener('progress:updated', updateStats);
    });
</script>

<style>
    /* ... existing styles ... */
    

    .badges-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    h1 {
        font-size: 3rem;
        background: linear-gradient(to right, #fbbf24, #f59e0b); /* Gold gradient */
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .page-header p {
        color: #a1a1aa;
        font-size: 1.1rem;
    }

    .stats-overview {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-top: 2rem;
    }

    .stat-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: rgba(255,255,255,0.05);
        padding: 1rem 2rem;
        border-radius: 1rem;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .stat-value {
        font-size: 2rem;
        font-weight: bold;
        color: white;
    }

    .stat-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
    }
</style>
