---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Friend from '../../components/Friend.astro';
import ChatBox from '../../components/ChatBox.astro';
import Quiz from '../../components/Quiz.astro';
import AnimationStage from '../../components/AnimationStage.astro';
import { getScenarioById, loadScenarios } from '../../lib/scenario-loader';

export async function getStaticPaths() {
  const scenarios = await loadScenarios('es');
  return scenarios.map(s => ({
    params: { slug: s.id }
  }));
}

const { slug } = Astro.params;
const scenario = await getScenarioById(slug || '');

if (!scenario) {
  return Astro.redirect('/404');
}

const COMPETENCIA_LABELS: Record<string, string> = {
  pensamiento_critico: 'Pensamiento crítico',
  calidad_preguntas: 'Calidad de las preguntas',
  autonomia_creativa: 'Autonomía creativa',
  verificacion: 'Verificación',
};
const competenciaLabel = scenario.competencia_foco ? COMPETENCIA_LABELS[scenario.competencia_foco] : null;
---

<Layout title={`Kidia - ${scenario.title}`} description={scenario.description}>
  <Header />
  
  <main class="scenario-layout" data-unidad={scenario.unidad}>
    <aside class="sidebar">
       <div class="friend-wrapper">
          <img 
            src="/kidia_explaining.webp" 
            alt="Kidia" 
            class="kidia-explaining" 
            id="kidia-expression"
            data-default="explaining"
          />
       </div>
       <div class="scenario-info">
           <h1>{scenario.title}</h1>
           <p>{scenario.description}</p>

           {(scenario.duracion_min || competenciaLabel) && (
             <div class="meta-row">
                {scenario.duracion_min && (
                  <span class="meta-pill">⏱ {scenario.duracion_min[0]}–{scenario.duracion_min[1]} min</span>
                )}
                {competenciaLabel && (
                  <span class="meta-pill">🧠 {competenciaLabel}</span>
                )}
             </div>
           )}

           {scenario.objetivo && (
             <div class="info-card">
                <h2>🎯 Qué vas a aprender</h2>
                <p>{scenario.objetivo}</p>
             </div>
           )}

           {scenario.producto && (
             <div class="info-card">
                <h2>📦 Vas a crear</h2>
                <p>{scenario.producto}</p>
             </div>
           )}

           {scenario.deep_mode?.enabled && (
             <div class="deep-mode-info">
                ℹ️ +Info Disponible
             </div>
           )}
       </div>

       <div class="badge-reward">
            <span class="badge-reward-label">Consigue la insignia</span>
            <div class="badge-reward-icon">{scenario.badge.icon}</div>
            <span class="badge-reward-name">{scenario.badge.name}</span>
            <p class="badge-reward-desc">{scenario.badge.description}</p>
       </div>
    </aside>
    
    <section class="chat-area">
        <ChatBox scenario={scenario} />
    </section>

    <Quiz scenario={scenario} />
    <AnimationStage />
  </main>

  <script>
    // Todo reto requiere sesión + hijo/a activo. La Unidad 1.1 (reto de
    // prueba gratuito) no exige además una suscripción activa; el resto sí.
    // Nota: este debe ser un script de módulo con imports estáticos (no
    // define:vars + import() dinámico) porque un script no-módulo resuelve
    // los specifiers relativos contra la URL del documento, no del archivo,
    // y el import() fallaba en silencio dejando la página sin protección.
    import { requireActiveChild } from '../../lib/require-auth';
    import { SubscriptionService } from '../../lib/subscription-service';

    const unidad = document.querySelector('.scenario-layout')?.getAttribute('data-unidad') || '';

    (async () => {
      const allowed = await requireActiveChild();
      if (!allowed) return;

      if (unidad === '1.1') return;

      const hasPlan = await SubscriptionService.hasActivePlan();

      if (!hasPlan) {
        window.location.href = '/caminos';
      }
    })();
  </script>

  <script>
    // Dynamic Kidia expression system
    const kidiaExpressions = {
      explaining: '/kidia_explaining.webp',
      thinking: '/kidia_thinking.webp',
      surprised: '/kidia_surprised.webp',
      error: '/kidia_error.webp',
      celebrating: '/kidia_celebrating.webp'
    };

    function setKidiaExpression(expression) {
      const kidiaImg = document.getElementById('kidia-expression');
      if (kidiaImg && kidiaExpressions[expression]) {
        kidiaImg.src = kidiaExpressions[expression];
        kidiaImg.alt = `Kidia ${expression}`;
      }
    }

    // Listen for custom events to change Kidia's expression
    window.addEventListener('kidia:expression', (e) => {
      const { expression } = e.detail;
      setKidiaExpression(expression);
    });

    // Change expression based on quiz results
    window.addEventListener('quiz:correct', () => {
      setKidiaExpression('celebrating');
      setTimeout(() => setKidiaExpression('explaining'), 3000);
    });

    window.addEventListener('quiz:incorrect', () => {
      setKidiaExpression('thinking');
      setTimeout(() => setKidiaExpression('explaining'), 2000);
    });

    window.addEventListener('quiz:error', () => {
      setKidiaExpression('error');
      setTimeout(() => setKidiaExpression('explaining'), 3000);
    });
    
    // Badge unlocked celebration
    window.addEventListener('badge:unlocked', () => {
      setKidiaExpression('celebrating');
      setTimeout(() => setKidiaExpression('surprised'), 2000);
      setTimeout(() => setKidiaExpression('explaining'), 4000);
    });
  </script>
</Layout>

<style>
    .scenario-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        height: calc(100vh - 80px);
    }
    
    @media (min-width: 768px) {
        .scenario-layout {
            grid-template-columns: 300px 1fr;
        }
    }
    
    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
        text-align: center;
        overflow-y: auto;
        padding-bottom: 1rem;
    }

    .friend-wrapper {
        margin-top: 1rem;
        flex-shrink: 0;
    }

    .kidia-explaining {
        width: 140px;
        height: auto;
        filter: drop-shadow(0 8px 20px rgba(34, 211, 238, 0.3));
        animation: float-kidia 3s ease-in-out infinite;
    }

    @keyframes float-kidia {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    .scenario-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }

    .scenario-info h1 {
        font-size: 1.4rem;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .scenario-info > p {
        color: #a1a1aa;
        font-size: 0.9rem;
        margin: 0;
    }

    .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

    .meta-pill {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        font-size: 0.75rem;
        padding: 0.3rem 0.7rem;
        border-radius: 99px;
        white-space: nowrap;
    }

    .info-card {
        text-align: left;
        background: var(--color-surface);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.9rem;
        padding: 1rem 1.1rem;
    }

    .info-card h2 {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--color-primary);
        margin-bottom: 0.4rem;
    }

    .info-card p {
        margin: 0;
        font-size: 0.9rem;
        color: #e4e4e7;
        line-height: 1.5;
    }

    .badge-reward {
        flex-shrink: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        padding: 1.5rem 1.25rem;
        border-radius: 1.25rem;
        background: linear-gradient(160deg, rgba(34, 211, 238, 0.12), rgba(139, 92, 246, 0.12));
        border: 1px solid rgba(34, 211, 238, 0.35);
        box-shadow: 0 0 30px rgba(34, 211, 238, 0.12);
    }

    .badge-reward-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #a1a1aa;
    }

    .badge-reward-icon {
        font-size: 3.5rem;
        line-height: 1;
        margin: 0.4rem 0;
        filter: drop-shadow(0 0 20px rgba(34, 211, 238, 0.5));
    }

    .badge-reward-name {
        font-weight: 700;
        font-size: 1.05rem;
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .badge-reward-desc {
        margin: 0.2rem 0 0 0;
        font-size: 0.8rem;
        color: #a1a1aa;
        line-height: 1.4;
    }

    .chat-area {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
</style>
