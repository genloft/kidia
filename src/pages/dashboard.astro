---
// Selector de perfiles (Fase 2, doc 02 §2.2): "¿Quién va a jugar?" estilo
// elige-tu-personaje. Sustituye al antiguo dashboard de dos tarjetas
// (Mapa/Constructor): elegir hijo/a lleva directo al Mapa; el Constructor
// sigue accesible desde la navegación.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Kidia - ¿Quién va a jugar?" showFooter={false}>
  <Header mode="aventura" />

  <main class="perfiles">
    <h1>¿Quién va a jugar hoy?</h1>
    <p class="perfiles-sub">Cada explorador/a tiene su propio progreso y sus misiones.</p>

    <div id="perfiles-grid" class="perfiles-grid" aria-busy="true"></div>

    <a class="k-btn k-btn--ghost k-btn--sm perfiles-gestionar" href="/parents">Gestionar hijos/as 🔒</a>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { ChildrenService } from '../lib/children-service';
  import { activeChild } from '../lib/active-child';
  import { SyncService } from '../lib/sync-service';
  import { tramoForChild } from '../lib/tramos';

  const grid = document.getElementById('perfiles-grid') as HTMLElement;

  async function elegir(childId: string) {
    activeChild.set(childId);
    await SyncService.onLogin();
    window.location.href = '/mapa';
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
      return;
    }

    const children = await ChildrenService.listChildren();

    // Sin hijos aún → wizard de bienvenida (crea el perfil y lleva a la
    // primera misión).
    if (children.length === 0) {
      window.location.href = '/bienvenida';
      return;
    }

    // Un solo hijo/a: no hay nada que elegir — directo al Mapa.
    if (children.length === 1) {
      await elegir(children[0].id);
      return;
    }

    grid.innerHTML = '';
    grid.setAttribute('aria-busy', 'false');

    children.forEach(child => {
      const tramo = tramoForChild(child.birth_date);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'perfil-card';
      const inicial = (child.avatar || child.name.charAt(0)).toUpperCase();
      btn.innerHTML = `
        <span class="perfil-avatar" aria-hidden="true">${inicial}</span>
        <strong class="perfil-nombre">${child.name}</strong>
        ${tramo ? `<span class="k-pill k-pill--accent">${tramo.label}</span>` : ''}
      `;
      btn.addEventListener('click', () => {
        btn.disabled = true;
        elegir(child.id);
      });
      grid.appendChild(btn);
    });
  }

  init();
</script>

<style>
  .perfiles {
    max-width: 860px;
    margin: 0 auto;
    padding: var(--k-space-16) var(--k-space-4) var(--k-space-24);
    min-height: calc(100vh - 72px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--k-space-4);
  }

  .perfiles-sub {
    margin: 0;
  }

  .perfiles-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--k-space-6);
    margin: var(--k-space-8) 0;
  }

  /* Tarjeta de perfil generada por JS (estilos globales a propósito) */
  .perfiles :global(.perfil-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--k-space-3);
    width: 180px;
    padding: var(--k-space-6) var(--k-space-4);
    background: var(--k-bg-surface);
    border: 1px solid var(--k-border-subtle);
    border-radius: var(--radius-lg);
    cursor: pointer;
    font-family: inherit;
    transition:
      transform var(--k-motion-base) var(--k-ease-out),
      border-color var(--k-motion-base) var(--k-ease-out),
      box-shadow var(--k-motion-base) var(--k-ease-out);
  }

  .perfiles :global(.perfil-card:hover) {
    transform: translateY(-4px);
    border-color: var(--k-brand-primary);
    box-shadow: var(--k-glow-primary);
  }

  .perfiles :global(.perfil-card:disabled) {
    opacity: 0.6;
  }

  .perfiles :global(.perfil-avatar) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--k-text-inverse);
    background: linear-gradient(135deg, var(--k-brand-primary), var(--k-brand-accent));
  }

  .perfiles :global(.perfil-nombre) {
    font-size: var(--k-text-xl);
    color: var(--k-text-strong);
  }

  .perfiles-gestionar {
    color: var(--k-text-muted);
  }
</style>
