---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Kidia - Selecciona tu destino">
  <Header />

  <main class="dashboard-container">
    <div class="dashboard-header">
      <h1 class="title">¿Qué quieres hacer hoy?</h1>
      <p class="subtitle">Elige tu próxima aventura en Kidia</p>
    </div>

    <div class="options-grid">
      <!-- Mapa Option -->
      <a href="/mapa" class="option-card map-card">
        <div class="card-content">
          <div class="icon-wrap">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
              <line x1="9" y1="3" x2="9" y2="18"></line>
              <line x1="15" y1="6" x2="15" y2="21"></line>
            </svg>
          </div>
          <h2>Mapa de Aventuras</h2>
          <p>Explora el mundo de Kidia, completa misiones y aprende IA paso a paso.</p>
          <span class="btn-outline">Entrar al Mapa</span>
        </div>
      </a>

      <!-- Constructor Option -->
      <a href="/constructor" class="option-card constructor-card">
        <div class="card-content">
          <div class="icon-wrap">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <h2>Constructor IA</h2>
          <p>Crea tus propios asistentes virtuales y dales instrucciones personalizadas.</p>
          <span class="btn-outline">Entrar al Constructor</span>
        </div>
      </a>
    </div>
  </main>
</Layout>

<style>
  .dashboard-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 2rem;
    min-height: calc(100vh - 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .dashboard-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .title {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: #f1f5f9;
  }

  .subtitle {
    font-size: 1.2rem;
    color: #94a3b8;
  }

  .options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .option-card {
    position: relative;
    border-radius: 1.5rem;
    padding: 3px;
    text-decoration: none;
    color: white;
    transition: all 0.3s ease;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .option-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 0;
    opacity: 0.1;
    transition: opacity 0.3s ease;
  }

  .map-card::before {
    background: linear-gradient(135deg, #10b981, #3b82f6);
  }

  .constructor-card::before {
    background: linear-gradient(135deg, #8b5cf6, #ec4899);
  }

  .option-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .option-card:hover::before {
    opacity: 0.2;
  }

  .card-content {
    position: relative;
    z-index: 1;
    background: #0f172a;
    padding: 3rem 2rem;
    border-radius: 1.4rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .icon-wrap {
    margin-bottom: 1.5rem;
    padding: 1rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
  }

  .map-card .icon-wrap {
    color: #38bdf8;
  }

  .constructor-card .icon-wrap {
    color: #c084fc;
  }

  .option-card h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .option-card p {
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .btn-outline {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 99px;
    font-weight: 600;
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  .option-card:hover .btn-outline {
    background: white;
    color: #0f172a;
  }

  @media (max-width: 768px) {
    .options-grid {
      grid-template-columns: 1fr;
    }
    .dashboard-container {
      padding: 2rem 1rem;
    }
    .title {
      font-size: 2.2rem;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  // Prevent logged out users from seeing this
  supabase.auth.getSession().then(({ data: { session } }) => {
    if (!session) {
      window.location.href = '/login';
    }
  });
</script>
