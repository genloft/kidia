---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { TRAMOS } from '../lib/tramos';
import { PLANS } from '../lib/subscription-service';
---

<Layout title="Kidia - Caminos y Planes" description="Descubre cómo Kidia adapta el aprendizaje de IA a la edad de tu hijo/a y elige el plan de suscripción familiar que mejor os encaje.">
  <Header />

  <main class="caminos-container">
    <div class="caminos-header">
      <h1 class="text-gradient">Cómo aprende tu hijo/a según su edad</h1>
      <p>Kidia adapta automáticamente el lenguaje, la duración y el nivel de autonomía a la edad de cada hijo/a — no hace falta elegir nada, se ajusta solo a partir de su fecha de nacimiento.</p>
    </div>

    <div class="tramos-grid">
      {TRAMOS.map(t => (
        <div class="card tramo-card">
          <div class="tramo-age">{t.label}</div>
          <p class="tramo-desc">{t.descripcion}</p>
          <ul class="tramo-meta">
            <li><strong>Sesión:</strong> {t.sesion}</li>
            <li><strong>Autonomía:</strong> {t.autonomia}</li>
            <li><strong>Personajes:</strong> {t.personajes}</li>
          </ul>
        </div>
      ))}
    </div>

    <div class="planes-header">
      <h2 class="text-gradient">Planes de suscripción</h2>
      <p>Una única suscripción familiar da acceso a todos tus hijos/as, cada uno en su propio tramo.</p>
    </div>

    <div id="planes-status" class="planes-status hidden"></div>

    <div class="planes-grid">
      {PLANS.map((p, i) => (
        <div class={`card plan-card ${i === 1 ? 'plan-featured' : ''}`}>
          <h3>{p.name}</h3>
          <p class="plan-price">{(p.priceCents / 100).toFixed(2).replace('.', ',')} € <span>/ mes</span></p>
          <ul class="plan-features">
            {p.features.map(f => <li>{f}</li>)}
          </ul>
          <button type="button" class="btn btn-subscribe" data-plan={p.id}>Suscribirse</button>
        </div>
      ))}
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { SubscriptionService, PLANS } from '../lib/subscription-service';

  const statusBox = document.getElementById('planes-status');

  async function refreshStatus() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      statusBox.classList.add('hidden');
      return;
    }

    const sub = await SubscriptionService.getSubscription();
    if (sub?.plan_status === 'active') {
      const plan = PLANS.find(p => p.id === sub.plan);
      statusBox.textContent = `Tu familia ya tiene el plan "${plan?.name}" activo.`;
      statusBox.classList.remove('hidden');
    } else {
      statusBox.classList.add('hidden');
    }
  }

  document.querySelectorAll('.btn-subscribe').forEach(btn => {
    btn.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }

      const planId = btn.dataset.plan;
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Activando...';

      const { error } = await SubscriptionService.activatePlan(planId);

      btn.disabled = false;
      btn.textContent = original;

      if (error) {
        alert('No se pudo activar el plan: ' + error);
        return;
      }

      await refreshStatus();
      alert(`¡Plan activado! Ya puedes añadir hijos/as desde tu perfil y jugar las misiones de Kidia.`);
    });
  });

  refreshStatus();
</script>

<style>
  .caminos-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .caminos-header,
  .planes-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .planes-header {
    margin-top: 5rem;
  }

  .caminos-header h1,
  .planes-header h2 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .caminos-header p,
  .planes-header p {
    color: var(--text-muted, #94a3b8);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tramos-grid,
  .planes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .tramo-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tramo-age {
    display: inline-block;
    align-self: flex-start;
    background: rgba(34, 211, 238, 0.15);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
  }

  .tramo-desc {
    color: var(--text-muted, #94a3b8);
    line-height: 1.6;
    margin: 0;
  }

  .tramo-meta {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted, #94a3b8);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tramo-meta strong {
    color: var(--color-text, #e4e4e7);
  }

  .planes-status {
    text-align: center;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.3);
    color: var(--color-primary);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
  }

  .hidden { display: none; }

  .plan-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .plan-featured {
    border-color: var(--color-primary);
    box-shadow: 0 0 30px rgba(34, 211, 238, 0.15);
  }

  .plan-card h3 {
    font-size: 1.3rem;
  }

  .plan-price {
    font-size: 2rem;
    font-weight: 800;
    margin: 0;
  }

  .plan-price span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted, #94a3b8);
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
    color: var(--text-muted, #94a3b8);
    font-size: 0.9rem;
  }

  .plan-features li::before {
    content: '✓ ';
    color: var(--color-primary);
    font-weight: 700;
  }

  .btn-subscribe {
    width: 100%;
  }
</style>
