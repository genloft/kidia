---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Kidia - Acceso">
  <Header />

  <main class="login-container">
    <div class="auth-card">

      <!-- Marca -->
      <div class="brand">
        <span class="brand-logo">Kidia</span>
        <span class="brand-badge">beta</span>
      </div>

      <h1 class="auth-title">Bienvenido de nuevo</h1>
      <p class="auth-subtitle">Guarda tu progreso y accede a misiones premium.</p>

      <!-- Tabs -->
      <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('login')">Iniciar Sesión</button>
        <button class="tab-btn" onclick="switchTab('register')">Registrarse</button>
      </div>

      <!-- Login Form -->
      <form id="login-form" class="auth-form">
        <div class="field">
          <label>Correo electrónico</label>
          <input type="email" name="email" placeholder="hola@ejemplo.com" required />
        </div>
        <div class="field">
          <label>Contraseña</label>
          <input type="password" name="password" placeholder="Tu contraseña" required />
        </div>
        <button type="submit" class="btn-submit">
          Iniciar Sesión
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </form>

      <!-- Register Form -->
      <form id="register-form" class="auth-form hidden">
        <div class="field">
          <label>Correo electrónico</label>
          <input type="email" name="email" placeholder="hola@ejemplo.com" required />
        </div>
        <div class="field">
          <label>Contraseña</label>
          <input type="password" name="password" placeholder="Mínimo 6 caracteres" minlength="6" required />
        </div>
        <button type="submit" class="btn-submit">
          Crear Cuenta
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </form>

      <!-- Mensaje -->
      <div id="auth-message" class="message hidden"></div>

      <!-- Separador -->
      <div class="divider"><span>o continúa con</span></div>

      <!-- Google -->
      <button id="google-login" class="btn-google">
        <svg viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
          <g transform="matrix(1, 0, 0, 1, 27.009001, -39.238998)">
            <path fill="#4285F4" d="M -3.264 51.509 C -3.264 50.719 -3.334 49.969 -3.454 49.239 L -14.754 49.239 L -14.754 53.749 L -8.284 53.749 C -8.574 55.229 -9.424 56.479 -10.684 57.329 L -10.684 60.329 L -6.824 60.329 C -4.564 58.239 -3.264 55.159 -3.264 51.509 Z"/>
            <path fill="#34A853" d="M -14.754 63.239 C -11.514 63.239 -8.804 62.159 -6.824 60.329 L -10.684 57.329 C -11.764 58.049 -13.134 58.489 -14.754 58.489 C -17.884 58.489 -20.534 56.379 -21.484 53.529 L -25.464 53.529 L -25.464 56.619 C -23.494 60.539 -19.424 63.239 -14.754 63.239 Z"/>
            <path fill="#FBBC05" d="M -21.484 53.529 C -21.734 52.809 -21.864 52.039 -21.864 51.239 C -21.864 50.439 -21.724 49.669 -21.484 48.949 L -21.484 45.859 L -25.464 45.859 C -26.284 47.479 -26.754 49.299 -26.754 51.239 C -26.754 53.179 -26.284 54.999 -25.464 56.619 L -21.484 53.529 Z"/>
            <path fill="#EA4335" d="M -14.754 43.989 C -12.984 43.989 -11.354 44.599 -10.104 45.789 L -6.744 42.429 C -8.804 40.509 -11.514 39.239 -14.754 39.239 C -19.424 39.239 -23.494 41.939 -25.464 45.859 L -21.484 48.949 C -20.534 46.099 -17.884 43.989 -14.754 43.989 Z"/>
          </g>
        </svg>
        Continuar con Google
      </button>

    </div>
  </main>
</Layout>

<script is:inline>
  function switchTab(tab) {
    const loginForm = document.getElementById('login-form');
    const registerForm = document.getElementById('register-form');
    const tabs = document.querySelectorAll('.tab-btn');
    const msg = document.getElementById('auth-message');
    const title = document.querySelector('.auth-title');

    msg.classList.add('hidden');

    if (tab === 'login') {
      loginForm.classList.remove('hidden');
      registerForm.classList.add('hidden');
      tabs[0].classList.add('active');
      tabs[1].classList.remove('active');
      title.textContent = 'Bienvenido de nuevo';
    } else {
      loginForm.classList.add('hidden');
      registerForm.classList.remove('hidden');
      tabs[0].classList.remove('active');
      tabs[1].classList.add('active');
      title.textContent = 'Crea tu cuenta';
    }
  }
</script>

<script>
  import { supabase } from '../lib/supabase';

  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const registerForm = document.getElementById('register-form') as HTMLFormElement;
  const googleBtn = document.getElementById('google-login');
  const msg = document.getElementById('auth-message');

  function showMessage(text: string, type = 'error') {
    msg!.textContent = text;
    msg!.className = `message ${type}`;
    msg!.classList.remove('hidden');
  }

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = loginForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Entrando...';
    btn.disabled = true;
    const formData = new FormData(loginForm);
    const { error } = await supabase.auth.signInWithPassword({
      email: formData.get('email') as string,
      password: formData.get('password') as string,
    });
    if (error) {
      showMessage(error.message);
      btn.textContent = 'Iniciar Sesión';
      btn.disabled = false;
    } else {
      window.location.href = '/mapa';
    }
  });

  registerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = registerForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Creando cuenta...';
    btn.disabled = true;
    const formData = new FormData(registerForm);
    const { error } = await supabase.auth.signUp({
      email: formData.get('email') as string,
      password: formData.get('password') as string,
      options: { emailRedirectTo: `${window.location.origin}/auth/callback` }
    });
    if (error) {
      showMessage(error.message);
      btn.textContent = 'Crear Cuenta';
      btn.disabled = false;
    } else {
      showMessage('¡Cuenta creada! Revisa tu email para confirmar.', 'success');
    }
  });

  googleBtn?.addEventListener('click', async () => {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${window.location.origin}/auth/callback` }
    });
    if (error) showMessage(error.message);
  });
</script>

<style>
  /* ===== CONTAINER ===== */
  .login-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 72px);
    padding: 2rem 1.5rem;
  }

  /* ===== CARD ===== */
  .auth-card {
    width: 100%;
    max-width: 440px;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1.75rem;
    padding: 2.5rem 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 32px 64px -16px rgba(0, 0, 0, 0.4);
  }

  /* ===== BRAND ===== */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .brand-logo {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #22d3ee, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand-badge {
    font-size: 0.7rem;
    background: rgba(255,255,255,0.08);
    color: #64748b;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-weight: 500;
  }

  /* ===== TITLES ===== */
  .auth-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }

  .auth-subtitle {
    font-size: 0.9rem;
    color: #64748b;
    margin: -0.5rem 0 0;
    line-height: 1.5;
  }

  /* ===== TABS ===== */
  .tabs {
    display: flex;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.75rem;
    padding: 4px;
    gap: 4px;
  }

  .tab-btn {
    flex: 1;
    background: none;
    border: none;
    color: #64748b;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem;
    cursor: pointer;
    border-radius: 0.55rem;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .tab-btn.active {
    background: rgba(34, 211, 238, 0.12);
    color: #22d3ee;
  }

  /* ===== FORM ===== */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #94a3b8;
    letter-spacing: 0.02em;
  }

  .auth-form input {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 0.65rem;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #f1f5f9;
    font-size: 0.95rem;
    font-family: inherit;
    transition: all 0.25s ease;
    box-sizing: border-box;
  }

  .auth-form input::placeholder {
    color: #334155;
  }

  .auth-form input:focus {
    outline: none;
    border-color: rgba(34, 211, 238, 0.35);
    background: rgba(30, 41, 59, 0.8);
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.07);
  }

  /* ===== SUBMIT BUTTON ===== */
  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.9rem 1.5rem;
    background: linear-gradient(135deg, #22d3ee, #818cf8);
    color: #0f172a;
    font-weight: 700;
    font-size: 0.95rem;
    border: none;
    border-radius: 0.65rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
    margin-top: 0.25rem;
  }

  .btn-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -8px rgba(34, 211, 238, 0.35);
    filter: brightness(1.05);
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* ===== MESSAGES ===== */
  .message {
    padding: 0.85rem 1rem;
    border-radius: 0.65rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .message.error {
    background: rgba(239, 68, 68, 0.08);
    border-left: 3px solid #ef4444;
    color: #fca5a5;
  }

  .message.success {
    background: rgba(34, 197, 94, 0.08);
    border-left: 3px solid #22c55e;
    color: #86efac;
  }

  .hidden { display: none; }

  /* ===== DIVIDER ===== */
  .divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #334155;
    font-size: 0.8rem;
  }

  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
  }

  /* ===== GOOGLE BUTTON ===== */
  .btn-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 0.65rem;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .btn-google:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.14);
    color: #f1f5f9;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 480px) {
    .auth-card {
      padding: 2rem 1.5rem;
      border-radius: 1.25rem;
    }
  }
</style>
