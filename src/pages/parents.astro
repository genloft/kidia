---
// Panel Familiar — home del Modo Familia (doc 02 §1 y §2.7).
// Unifica en una sola pantalla lo que antes vivía repartido entre
// parents.astro (informe del hijo activo) y perfil.astro#hijos (gestión):
// progreso de TODOS los hijos/as (datos de la nube, tabla children),
// añadir/eliminar hijos, PIN familiar del gate y la info de confianza
// (método + privacidad). Protegida por el gate con PIN (familia-gate.ts).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Kidia - Panel Familiar" description="Panel para madres y padres: progreso de cada hijo/a, gestión de la familia, PIN de acceso y cómo funciona el Método Kidia por dentro.">
  <Header mode="familia" />

  <main class="familia-container familia-locked" id="familia-main">
    <h1>Panel Familiar 🛡️</h1>
    <p class="intro">Todo lo tuyo está aquí: el progreso de cada explorador/a, la gestión de la familia y cómo protegemos sus datos.</p>

    <section class="info-block">
        <h2>👦 Tus exploradores/as</h2>
        <div id="hijos-error" class="alert error hidden" role="alert"></div>
        <div id="hijos-grid" class="hijos-grid" aria-busy="true">
            <p class="hijos-loading">Cargando datos...</p>
        </div>

        <form id="add-child-form" class="add-child-form">
          <div class="input-group">
            <label for="new_child_name">Nombre</label>
            <input type="text" id="new_child_name" placeholder="Ej. Leo" required />
          </div>
          <div class="input-group">
            <label for="new_child_dob">Fecha de nacimiento</label>
            <input type="date" id="new_child_dob" />
          </div>
          <button type="submit" class="k-btn k-btn--primary k-btn--md btn-add-child">+ Añadir hijo/a</button>
        </form>
    </section>

    <section class="info-block">
        <h2>🔒 PIN familiar</h2>
        <p id="pin-status">Comprobando…</p>
        <form id="pin-form" class="pin-form">
            <div class="input-group">
                <label for="pin-input">PIN de 4 números</label>
                <input
                    id="pin-input"
                    type="password"
                    inputmode="numeric"
                    autocomplete="off"
                    pattern="[0-9]{4}"
                    maxlength="4"
                    placeholder="••••"
                    required
                />
            </div>
            <button type="submit" class="k-btn k-btn--secondary k-btn--md" id="pin-save-btn">Guardar PIN</button>
            <button type="button" class="k-btn k-btn--ghost k-btn--md" id="pin-remove-btn" hidden>Quitar PIN</button>
        </form>
        <p class="pin-nota">Con PIN activo, entrar al Panel Familiar desde la vista del niño/a pide este código. Es una barrera para que no entre por despiste, no una caja fuerte.</p>
    </section>

    <section class="info-block">
        <h2>¿Qué aprenden aquí?</h2>
        <p>Kidia no enseña a "usar" herramientas de IA ciegamente. Enseña <strong>cómo pensar con ellas</strong>, a través de misiones cortas guiadas por la Dra. Vael (y, a partir de los 12 años, también por Morti).</p>
        <ul>
            <li><strong>4 niveles progresivos:</strong> Entender → Usar bien → Crear → Construir.</li>
            <li><strong>4 competencias que trabajamos en cada misión:</strong> pensamiento crítico, calidad de las preguntas (prompts), autonomía creativa y verificación de datos.</li>
            <li><strong>Se adapta sola a la edad:</strong> el lenguaje, la duración y el nivel de autonomía cambian según el tramo (8-9, 10-11 o 12-14 años) de cada hijo/a, sin que tengáis que elegir nada.</li>
        </ul>
    </section>

    <section class="info-block">
        <h2>Privacidad y Datos</h2>
        <ul class="check-list">
            <li>✅ El progreso se sincroniza de forma segura en la nube (Supabase).</li>
            <li>✅ Todos los datos están protegidos por políticas estrictas de acceso (RLS).</li>
            <li>✅ Nunca compartiremos los datos con terceros.</li>
            <li>✅ No hay trackers de publicidad ni analíticas intrusivas.</li>
        </ul>
    </section>

    <p class="cuenta-link">Tu correo, contraseña y datos de tutor/a están en <a href="/perfil">Mi Cuenta</a>.</p>
  </main>
</Layout>

<script>
    import { supabase } from '../lib/supabase';
    import { requireSession } from '../lib/require-auth';
    import { FamiliaGate } from '../lib/familia-gate';
    import { ProgressService } from '../lib/progress-service';
    import { ChildrenService } from '../lib/children-service';
    import { activeChild } from '../lib/active-child';
    import { SyncService } from '../lib/sync-service';
    import { calcAge, tramoForAge } from '../lib/tramos';
    import { showToast } from '../lib/toast';

    const main = document.getElementById('familia-main') as HTMLElement;
    const grid = document.getElementById('hijos-grid') as HTMLElement;
    const errorEl = document.getElementById('hijos-error') as HTMLElement;

    // Fila de children con las señales de progreso en nube (las columnas
    // que sincroniza SyncService + las del módulo unidad-aventura).
    interface ChildPanelRow {
        id: string;
        name: string;
        birth_date: string | null;
        completed_scenarios: string[] | null;
        badges: string[] | null;
        vocabulary: unknown[] | null;
        family_missions_completed: { mision_id: string }[] | null;
    }

    function escapeHtml(str: string): string {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function childMeta(birthDate: string | null): string {
        if (!birthDate) return '';
        const age = calcAge(birthDate);
        const tramo = tramoForAge(age);
        return `${age} años${tramo ? ' · ' + tramo.label : ''}`;
    }

    function renderChildCard(child: ChildPanelRow): string {
        const completed = child.completed_scenarios || [];
        const badges = child.badges || [];
        const familyMissions = child.family_missions_completed || [];
        const vocabularyCount = (child.vocabulary || []).length;

        const report = ProgressService.computeParentReportFrom({
            completedScenarios: completed,
            badges,
            familyMissionsCompleted: familyMissions as any,
            vocabularyCount,
        });

        return `
            <article class="hijo-card" data-id="${child.id}">
                <div class="hijo-card__head">
                    <strong class="hijo-card__nombre">${escapeHtml(child.name)}</strong>
                    <span class="hijo-card__meta">${childMeta(child.birth_date)}</span>
                </div>
                <div class="hijo-card__stats">
                    <div class="hijo-stat"><span class="hijo-stat__num">${completed.length}</span><span class="hijo-stat__label">Misiones</span></div>
                    <div class="hijo-stat"><span class="hijo-stat__num">${badges.length}</span><span class="hijo-stat__label">Insignias</span></div>
                    <div class="hijo-stat"><span class="hijo-stat__num">${vocabularyCount}</span><span class="hijo-stat__label">Palabras</span></div>
                    <div class="hijo-stat"><span class="hijo-stat__num">${familyMissions.length}</span><span class="hijo-stat__label">En familia</span></div>
                </div>
                <p class="hijo-card__report">${report}</p>
                <div class="hijo-card__actions">
                    <button type="button" class="k-btn k-btn--primary k-btn--sm btn-jugar" data-id="${child.id}">Jugar como ${escapeHtml(child.name)} →</button>
                    <button type="button" class="k-btn k-btn--ghost k-btn--sm btn-eliminar" data-id="${child.id}" data-name="${escapeHtml(child.name)}">Eliminar</button>
                </div>
            </article>
        `;
    }

    async function loadChildren() {
        grid.setAttribute('aria-busy', 'true');

        const { data, error } = await supabase
            .from('children')
            .select('id, name, birth_date, completed_scenarios, badges, vocabulary, family_missions_completed')
            .order('created_at', { ascending: true });

        grid.setAttribute('aria-busy', 'false');

        if (error) {
            console.error('[PanelFamiliar] Error cargando hijos:', error);
            grid.innerHTML = '';
            errorEl.textContent = 'No se pudieron cargar los datos. Recarga la página para reintentar.';
            errorEl.classList.remove('hidden');
            return;
        }

        const children = (data || []) as ChildPanelRow[];
        if (children.length === 0) {
            grid.innerHTML = `<p class="hijos-empty">Todavía no has añadido ningún hijo/a. Añádelo aquí abajo, o hazlo con la <a href="/bienvenida">bienvenida guiada</a> (recomendado: acaba en su primera misión).</p>`;
            return;
        }

        grid.innerHTML = children.map(renderChildCard).join('');

        grid.querySelectorAll<HTMLButtonElement>('.btn-jugar').forEach(btn => {
            btn.addEventListener('click', async () => {
                btn.disabled = true;
                activeChild.set(btn.dataset.id!);
                await SyncService.onLogin();
                // Al pasar al Modo Aventura se echa el candado del gate.
                FamiliaGate.lock();
                window.location.href = '/mapa';
            });
        });

        grid.querySelectorAll<HTMLButtonElement>('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', async () => {
                const name = btn.dataset.name || 'este hijo/a';
                if (!confirm(`¿Seguro que quieres eliminar a ${name}? Se perderá su progreso e inscripciones.`)) return;
                const { error } = await ChildrenService.deleteChild(btn.dataset.id!);
                if (error) {
                    showToast('No se pudo eliminar. Inténtalo de nuevo.', { variant: 'danger' });
                } else {
                    if (activeChild.get() === btn.dataset.id) activeChild.clear();
                    showToast(`${name} eliminado/a.`, { variant: 'success' });
                    loadChildren();
                }
            });
        });
    }

    // ---- Añadir hijo/a ----

    const addChildForm = document.getElementById('add-child-form') as HTMLFormElement;
    addChildForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');

        const nameInput = document.getElementById('new_child_name') as HTMLInputElement;
        const dobInput = document.getElementById('new_child_dob') as HTMLInputElement;

        const { error } = await ChildrenService.addChild(nameInput.value.trim(), dobInput.value || null);
        if (error) {
            errorEl.textContent = error;
            errorEl.classList.remove('hidden');
            return;
        }

        showToast(`${nameInput.value.trim()} añadido/a a la familia.`, { variant: 'success' });
        nameInput.value = '';
        dobInput.value = '';
        loadChildren();
    });

    // ---- PIN familiar ----

    const pinStatus = document.getElementById('pin-status') as HTMLElement;
    const pinForm = document.getElementById('pin-form') as HTMLFormElement;
    const pinInput = document.getElementById('pin-input') as HTMLInputElement;
    const pinSaveBtn = document.getElementById('pin-save-btn') as HTMLButtonElement;
    const pinRemoveBtn = document.getElementById('pin-remove-btn') as HTMLButtonElement;

    async function refreshPinStatus() {
        const hasPin = await FamiliaGate.hasPin();
        if (hasPin) {
            pinStatus.innerHTML = '✅ <strong>PIN activo.</strong> El Modo Familia lo pide al entrar desde la vista del niño/a.';
            pinSaveBtn.textContent = 'Cambiar PIN';
            pinRemoveBtn.hidden = false;
        } else {
            pinStatus.innerHTML = '⚠️ <strong>Sin PIN.</strong> Ahora mismo tu hijo/a puede entrar aquí sin barrera. Crea un PIN de 4 números.';
            pinSaveBtn.textContent = 'Guardar PIN';
            pinRemoveBtn.hidden = true;
        }
    }

    pinForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        pinSaveBtn.disabled = true;
        const { error } = await FamiliaGate.setPin(pinInput.value);
        pinSaveBtn.disabled = false;

        if (error) {
            showToast(error, { variant: 'danger', duration: 5000 });
            return;
        }
        pinInput.value = '';
        showToast('PIN guardado. Ya protege el Modo Familia.', { variant: 'success' });
        refreshPinStatus();
    });

    pinRemoveBtn.addEventListener('click', async () => {
        if (!confirm('¿Quitar el PIN? El Modo Familia quedará sin barrera.')) return;
        pinRemoveBtn.disabled = true;
        const { error } = await FamiliaGate.removePin();
        pinRemoveBtn.disabled = false;

        if (error) {
            showToast(error, { variant: 'danger' });
            return;
        }
        showToast('PIN eliminado.', { variant: 'default' });
        refreshPinStatus();
    });

    // ---- Arranque: sesión → gate → mostrar y cargar ----

    requireSession().then(async (allowed) => {
        if (!allowed) return;
        const pass = await FamiliaGate.requireFamiliaAccess();
        if (!pass) return;

        main.classList.remove('familia-locked');
        loadChildren();
        refreshPinStatus();
    });
</script>

<style>
    .familia-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    /* Hasta pasar el gate, el contenido no se enseña (el modal del PIN
       aparece sobre la página; sin esto se leería el panel de fondo). */
    .familia-container.familia-locked {
        visibility: hidden;
    }

    h1 {
        font-size: var(--text-h1);
        margin-bottom: 1rem;
        background: linear-gradient(to right, #e879f9, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .intro {
        font-size: var(--k-text-lg);
        color: var(--k-text-body);
        margin-bottom: 2.5rem;
    }

    .info-block {
        margin-bottom: 2.5rem;
        padding: 2rem;
        background: var(--k-bg-surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--k-border-subtle);
    }

    .info-block h2 {
        color: var(--k-brand-primary);
        margin-bottom: 1rem;
    }

    .info-block p,
    .info-block ul {
        color: var(--k-text-body);
        line-height: 1.6;
    }

    .info-block ul {
        padding-left: 1.5rem;
    }

    .check-list {
        list-style: none;
        padding: 0;
    }

    .check-list li {
        margin-bottom: 0.5rem;
    }

    /* ---- Tarjetas de hijos/as (DOM generado por JS) ---- */

    .hijos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .hijos-grid :global(.hijos-loading),
    .hijos-grid :global(.hijos-empty) {
        grid-column: 1 / -1;
        color: var(--k-text-muted);
        text-align: center;
        padding: 1rem 0;
    }

    .hijos-grid :global(.hijos-empty a) {
        color: var(--k-brand-primary);
        text-decoration: underline;
    }

    .hijos-grid :global(.hijo-card) {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        background: var(--k-bg-page-deep);
        border: 1px solid var(--k-border-subtle);
        border-radius: var(--radius-md);
        padding: 1.25rem;
    }

    .hijos-grid :global(.hijo-card__head) {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .hijos-grid :global(.hijo-card__nombre) {
        font-size: var(--k-text-xl);
        color: var(--k-text-strong);
    }

    .hijos-grid :global(.hijo-card__meta) {
        font-size: var(--k-text-sm);
        color: var(--k-text-muted);
    }

    .hijos-grid :global(.hijo-card__stats) {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }

    .hijos-grid :global(.hijo-stat) {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: rgba(255, 255, 255, 0.03);
        border-radius: var(--radius-sm);
        padding: 0.5rem 0.25rem;
    }

    .hijos-grid :global(.hijo-stat__num) {
        font-size: var(--k-text-xl);
        font-weight: 800;
        color: var(--k-brand-primary);
    }

    .hijos-grid :global(.hijo-stat__label) {
        font-size: var(--k-text-xs);
        color: var(--k-text-muted);
    }

    .hijos-grid :global(.hijo-card__report) {
        margin: 0;
        font-size: var(--k-text-sm);
        color: var(--k-text-body);
        line-height: 1.5;
        flex: 1;
    }

    .hijos-grid :global(.hijo-card__actions) {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    /* ---- Formularios (añadir hijo/a + PIN) ---- */

    .add-child-form {
        display: grid;
        grid-template-columns: 2fr 1fr auto;
        gap: 1rem;
        align-items: end;
    }

    .pin-form {
        display: grid;
        grid-template-columns: minmax(120px, 200px) auto auto;
        gap: 1rem;
        align-items: end;
        margin-bottom: 1rem;
    }

    @media (max-width: 600px) {
        .add-child-form,
        .pin-form {
            grid-template-columns: 1fr;
            align-items: stretch;
        }
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .input-group label {
        font-size: var(--k-text-sm);
        font-weight: 600;
        color: var(--k-text-muted);
    }

    .input-group input {
        background: var(--k-bg-page-deep);
        border: 1px solid var(--k-border-subtle);
        padding: 0.7rem 1rem;
        border-radius: var(--radius-md);
        color: var(--k-text-strong);
        font-size: var(--k-text-base);
        font-family: inherit;
        transition: border-color var(--k-motion-fast) var(--k-ease-out);
    }

    .input-group input:focus {
        outline: none;
        border-color: var(--k-border-focus);
        box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.12);
    }

    .pin-nota {
        margin: 0;
        font-size: var(--k-text-sm);
        color: var(--k-text-muted);
    }

    .alert.error {
        padding: 1rem;
        border-radius: var(--radius-md);
        margin-bottom: 1.5rem;
        font-weight: 500;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: var(--k-state-danger);
    }

    .alert.hidden,
    .hidden,
    [hidden] {
        display: none !important;
    }

    .cuenta-link {
        color: var(--k-text-muted);
        text-align: center;
    }

    .cuenta-link a {
        color: var(--k-brand-primary);
        text-decoration: underline;
    }

    @media (max-width: 640px) {
        .familia-container {
            padding: 3rem 1.25rem;
        }
        .info-block {
            padding: 1.5rem;
        }
    }
</style>
