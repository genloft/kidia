<script>
  import { supabase } from '../lib/supabase';

  document.getElementById('scroll-cue')?.addEventListener('click', () => {
    document.getElementById('metodo')?.scrollIntoView({ behavior: 'smooth' });
  });

  supabase.auth.getSession().then(({ data: { session } }) => {
    if (session) {
      // Usuario ya logado: la home deja de vender el registro y pasa a ser
      // un acceso rápido a continuar donde lo dejó.
      document.getElementById('hero-eyebrow')?.classList.add('hidden');
      document.getElementById('hero-cta-row')?.classList.add('hidden');
      document.getElementById('hero-trust-strip')?.classList.add('hidden');
      document.getElementById('hero-guest-hint')?.classList.add('hidden');
      document.getElementById('hero-welcome-back')?.classList.remove('hidden');

      // El resto de CTA de "Regístrate gratis" repartidos por la home
      // tampoco aplican: los sustituimos por su equivalente ya-logado
      // (ir al panel, al mapa de retos o a gestionar el plan).
      document.querySelectorAll<HTMLAnchorElement>('.js-cta-register').forEach(el => {
        const loggedHref = el.dataset.loggedHref;
        const loggedText = el.dataset.loggedText;
        if (loggedHref) el.href = loggedHref;
        const label = el.querySelector('.cta-label');
        if (label && loggedText) {
          label.textContent = loggedText;
        } else if (loggedText) {
          el.textContent = loggedText;
        }
      });

      document.getElementById('cta-final-hint')?.classList.add('hidden');
    }
  });
</script>
