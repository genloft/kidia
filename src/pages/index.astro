---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { PLANS } from '../lib/subscription-service';
import { TRAMOS } from '../lib/tramos';

const NIVELES = [
  {
    n: 1,
    nombre: 'Entender',
    icon: '🧠',
    consigue: 'Vocabulario y criterio inicial',
    aprende: 'Qué es (y qué no es) la IA, cómo funciona y por qué se equivoca.',
  },
  {
    n: 2,
    nombre: 'Usar bien',
    icon: '🎯',
    consigue: 'Instruir, verificar y detectar errores',
    aprende: 'Escribir buenos prompts, comprobar con una fuente y cazar fallos.',
  },
  {
    n: 3,
    nombre: 'Crear',
    icon: '🎨',
    consigue: 'Convertir una idea en un proyecto',
    aprende: 'Diseñar un personaje, un cómic, un cartel; mejorar de la v1 a la v3.',
  },
  {
    n: 4,
    nombre: 'Construir',
    icon: '🚀',
    consigue: 'Proyectos reales completos',
    aprende: 'Un quiz, un audiocuento o una idea para su entorno; presentar y defender.',
  },
];

const CICLO = [
  { m: 'Chispa', icon: '✨', desc: 'Se engancha con un reto con sentido' },
  { m: 'Explora', icon: '🔍', desc: 'Comprende la idea de IA que necesita' },
  { m: 'Crea', icon: '🛠️', desc: 'Produce su proyecto con la IA como herramienta' },
  { m: 'Reflexiona', icon: '💭', desc: 'Verifica, piensa y mejora lo que hizo' },
  { m: 'Comparte', icon: '📣', desc: 'Publica su producto, con moderación' },
];

const HORIZONTES = [
  {
    cuando: '1 semana',
    aprende: 'Su primer reto guiado por la Dra. Vael, con la mecánica «Caza el error».',
    lleva: 'Su primer producto propio: ¡la IA también se equivoca!',
  },
  {
    cuando: '1 mes',
    aprende: 'Termina el Nivel 1 · Entender: sabe qué es la IA y por qué falla.',
    lleva: 'Su 1.ª insignia y la primera «foto de nivel» en el Panel Familiar.',
  },
  {
    cuando: '3 meses',
    aprende: 'Escribe prompts precisos y verifica todo con una fuente.',
    lleva: 'Insignias de los Niveles 1 y 2 y sus primeras creaciones.',
  },
  {
    cuando: '1 año',
    aprende: 'Completa los 4 niveles y defiende un proyecto real.',
    lleva: 'Certificado «creador con IA» y un portfolio con proyectos reales.',
  },
];

const COMPETENCIAS = ['Pensamiento crítico', 'Calidad de las preguntas', 'Autonomía creativa', 'Verificación'];

const STATS = [
  {
    num: '60%',
    text: 'de los menores de 9 a 16 años en España ya usa IA a diario, sin saber cómo funciona ni cuándo falla.',
    fuente: 'Staksrud et al., 2026',
  },
  {
    num: '3M',
    text: 'niños de 8 a 14 años en España van a crecer usando IA todos los días.',
  },
  {
    num: 'Ninguna',
    text: 'academia infantil en español enseña hoy a crear con IA de forma segura y pedagógica.',
  },
];

const CONFIANZA = [
  { icon: '🛡️', title: 'IA mediada, nunca un chat abierto', desc: 'Nunca habla con un chatbot abierto: todo pasa por la capa segura de Kidia.' },
  { icon: '📜', title: 'RGPD y consentimiento parental', desc: 'La cuenta la crea el adulto responsable. RGPD desde el diseño.' },
  { icon: '📊', title: 'Progreso por evidencia, no por horas', desc: 'Sin rachas ni premios aleatorios: se avanza demostrando la competencia.' },
  { icon: '👨‍👩‍👧', title: 'Panel Familiar con progreso real', desc: 'Resumen semanal y una pregunta para hablar en casa sobre lo creado.' },
];
---

<Layout title="Kidia - Aprende Inteligencia Artificial" description="Kidia es la academia online donde niños de 8 a 14 años aprenden Inteligencia Artificial jugando: retos interactivos, un constructor de IA y una mascota virtual que les acompaña.">
  <Header />

  <main>
    <div class="hero-container">
      <section class="hero">

        <!-- Left: Text + CTA -->
        <div class="hero-left">

          <span id="hero-eyebrow" class="eyebrow">6 de cada 10 niños ya usa IA sin criterio</span>

          <h1>
            Ayudamos a que tu hijo/a<br />
            <span class="text-gradient">piense en grande con la IA.</span>
          </h1>

          <p class="subtitle">
            Kidia es la academia online donde niños de 8 a 14 años aprenden IA de forma
            segura y guiada: sin chatbots abiertos, con una mascota, la Dra. Vael, que
            les acompaña en cada reto.
          </p>

          <div id="hero-cta-row" class="hero-cta-row">
            <a href="/login?tab=register" class="btn-cta hero-btn-primary">
              <span>Regístrate gratis</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="#metodo" class="btn-secondary hero-btn-ghost">Ver cómo funciona</a>
          </div>

          <ul id="hero-trust-strip" class="trust-strip">
            <li>🛡️ IA mediada y segura</li>
            <li>🇪🇸 100% en español</li>
            <li>✅ Sin permanencia</li>
          </ul>

          <p id="hero-guest-hint" class="hero-guest-hint">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>

          <!-- Estado logado: sustituye a la fila de CTA de arriba -->
          <div id="hero-welcome-back" class="hero-welcome-back hidden">
            <h2 class="welcome-title">¡Hola de nuevo! 👋</h2>
            <p class="welcome-sub">¿Qué aventura quieres continuar hoy?</p>
            <div class="welcome-actions">
              <a href="/mapa" class="btn-cta hero-btn-primary">
                <span>Explorar el Mapa</span>
              </a>
              <a href="/constructor" class="btn-secondary hero-btn-ghost">Entrar al Constructor IA</a>
            </div>
          </div>

        </div>

        <!-- Right: Mascot -->
        <div class="hero-right">
          <div class="mascot-glow"></div>
          <img
            src="/dravael-portada.webp"
            alt="Dra. Vael, la guía de Kidia"
            class="kidia-character"
            loading="eager"
          />
          <div class="floating-tag tag-1">
            <span class="tag-icon">🤖</span> IA Explicada
          </div>
          <div class="floating-tag tag-2">
            <span class="tag-icon">🛡️</span> Uso Seguro
          </div>
          <div class="floating-tag tag-3">
            <span class="tag-icon">🌟</span> Crea Proyectos
          </div>
        </div>

      </section>

      <button type="button" class="scroll-cue" id="scroll-cue" aria-label="Baja para descubrir el método Kidia">
        <span>Descubre el método Kidia</span>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
    </div>

    <!-- ====== PROBLEMA ====== -->
    <section class="problema-section" id="problema">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">La realidad hoy</span>
          <h2>Tu hijo/a ya usa IA. La pregunta es cómo.</h2>
          <p>La adopción entre menores ya es masiva, pero casi nadie les enseña a usarla con criterio.</p>
        </div>

        <div class="stat-grid">
          {STATS.map(s => (
            <div class="stat-card">
              <span class="stat-number">{s.num}</span>
              <p>{s.text}</p>
              {s.fuente && <span class="stat-fuente">Fuente: {s.fuente}</span>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== MÉTODO ====== -->
    <section class="metodo-section" id="metodo">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">El Método Kidia</span>
          <h2>4 niveles para crear con criterio</h2>
          <p>Todo alumno recorre la misma ruta, adaptada a su tramo de edad. No se avanza por horas jugadas, sino por evidencia.</p>
        </div>

        <div class="niveles-grid">
          {NIVELES.map(nv => (
            <div class="nivel-card">
              <div class="nivel-badge">Nivel {nv.n}</div>
              <div class="nivel-icon">{nv.icon}</div>
              <h3>{nv.nombre}</h3>
              <p class="nivel-consigue">{nv.consigue}</p>
              <p class="nivel-aprende">{nv.aprende}</p>
            </div>
          ))}
        </div>

        <div class="ciclo-strip">
          <p class="ciclo-label">Cada reto sigue siempre el mismo ciclo:</p>
          <div class="ciclo-steps">
            {CICLO.map((c, i) => (
              <>
                <div class="ciclo-step">
                  <span class="ciclo-icon">{c.icon}</span>
                  <strong>{c.m}</strong>
                  <span class="ciclo-desc">{c.desc}</span>
                </div>
                {i < CICLO.length - 1 && <span class="ciclo-arrow">→</span>}
              </>
            ))}
          </div>
        </div>

        <div class="tramos-strip">
          <p class="tramos-label">Y los 4 niveles se adaptan siempre a la edad de tu hijo/a — mismo contenido, distinta profundidad y autonomía:</p>
          <div class="tramos-mini-grid">
            {TRAMOS.map(t => (
              <div class="tramo-mini-card">
                <span class="tramo-mini-age">{t.label}</span>
                <p class="tramo-mini-desc">{t.descripcion}</p>
                <ul class="tramo-mini-meta">
                  <li><strong>Sesión:</strong> {t.sesion}</li>
                  <li><strong>Autonomía:</strong> {t.autonomia}</li>
                  <li><strong>Personajes:</strong> {t.personajes}</li>
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="inline-cta">
          <p>¿Listo para que tu hijo/a empiece a crear con IA?</p>
          <a href="/login?tab=register" id="inline-cta-btn" class="btn btn-inline-cta js-cta-register" data-logged-href="/mapa" data-logged-text="Ir al Mapa de Retos">Quiero que empiece — Regístrate gratis</a>
        </div>
      </div>
    </section>

    <!-- ====== RESULTADOS ====== -->
    <section class="resultados-section" id="resultados">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">La promesa, en concreto</span>
          <h2>Qué aprende tu hijo/a, semana a semana</h2>
          <p>Con un ritmo recomendado de 2-3 sesiones cortas por semana. El avance real depende de cada niño/a: se progresa por evidencia, no por tiempo de pantalla.</p>
        </div>

        <div class="horizontes-grid">
          {HORIZONTES.map(h => (
            <div class="horizonte-card">
              <div class="horizonte-cuando">{h.cuando}</div>
              <p class="horizonte-aprende">{h.aprende}</p>
              <p class="horizonte-lleva"><strong>Se lleva:</strong> {h.lleva}</p>
            </div>
          ))}
        </div>

        <div class="competencias-strip">
          <p class="competencias-label">Las 4 competencias que medimos (no solo el «uso»):</p>
          <div class="competencias-pills">
            {COMPETENCIAS.map(c => <span class="pill pill-accent">{c}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- ====== CONFIANZA ====== -->
    <section class="confianza-section" id="confianza">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Para que estés tranquilo/a</span>
          <h2>Diseñado pensando en las familias primero</h2>
        </div>

        <div class="confianza-grid">
          {CONFIANZA.map(c => (
            <div class="confianza-card">
              <div class="confianza-icon">{c.icon}</div>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== PRECIO ====== -->
    <section class="precio-section" id="precio">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Sin sorpresas</span>
          <h2>Menos que una extraescolar</h2>
          <p>El plan Familiar es ≈228 €/año, por debajo del gasto medio de una extraescolar en España (≈270 €/año) — en una competencia que hoy casi ninguna cubre.</p>
        </div>

        <div class="planes-grid">
          {PLANS.map((p, i) => (
            <div class={`card plan-card ${i === 1 ? 'plan-featured' : ''}`}>
              {i === 1 && <span class="plan-tag">Más elegido</span>}
              <h3>{p.name}</h3>
              <p class="plan-price">{(p.priceCents / 100).toFixed(2).replace('.', ',')} € <span>/ mes</span></p>
              <ul class="plan-features">
                {p.features.map(f => <li>{f}</li>)}
              </ul>
              <a href="/login?tab=register" class="btn btn-plan-cta js-cta-register" data-logged-href="/caminos" data-logged-text="Ver planes">Empezar con {p.name}</a>
            </div>
          ))}
        </div>

        <p class="precio-footnote">Suscripción familiar, sin permanencia. <a href="/caminos">Ver todos los detalles de los planes →</a></p>
      </div>
    </section>

    <!-- ====== CTA FINAL ====== -->
    <section class="cta-final-section">
      <div class="section-container cta-final-inner">
        <h2>Empieza gratis hoy</h2>
        <p>Crea la cuenta familiar, añade a tu hijo/a y en la primera semana ya tendrá su primer proyecto creado con IA. Sin permanencia, cancela cuando quieras.</p>
        <a href="/login?tab=register" id="final-cta-btn" class="btn-cta cta-final-btn js-cta-register" data-logged-href="/dashboard" data-logged-text="Ir a mi Panel">
          <span class="cta-label">Regístrate gratis</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <p id="cta-final-hint" class="cta-final-hint">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ===== RESET & BASE ===== */
  main {
    width: 100%;
    overflow-x: hidden;
  }

  .hero-container {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 6%;
  }

  .values-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 5%;
  }

  /* ===== HERO ===== */
  .hero {
    display: grid;
    grid-template-columns: 6fr 4fr;
    align-items: center;
    min-height: calc(100vh - 80px);
    gap: 4rem;
    padding: 2rem 0 4rem;
  }

  /* ===== HERO LEFT ===== */
  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    font-size: clamp(2.25rem, 3vw, 3.25rem);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    color: #f8fafc;
    max-width: 640px;
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 50%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 90%;
  }

  /* ===== BOTONES ===== */
  .btn-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1.1rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: #09090b;
    font-weight: 700;
    font-size: 1.1rem;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 20px -5px rgba(34, 211, 238, 0.4);
    font-family: inherit;
  }

  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 25px -5px rgba(34, 211, 238, 0.5);
    filter: brightness(1.08);
  }

  .btn-cta:active {
    transform: translateY(1px);
    box-shadow: 0 5px 10px -5px rgba(34, 211, 238, 0.4);
  }

  .btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1.1rem;
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    font-weight: 700;
    font-size: 1.05rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  /* ===== HERO GUEST HINT / WELCOME BACK ===== */
  .hero-guest-hint {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0;
  }

  .hero-guest-hint a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .hero-guest-hint a:hover {
    text-decoration: underline;
  }

  .hero-welcome-back {
    max-width: 460px;
  }

  .welcome-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem;
  }

  .welcome-sub {
    color: #94a3b8;
    margin: 0 0 1.5rem;
  }

  .welcome-actions {
    display: flex;
    gap: 1rem;
  }

  .welcome-actions .btn-cta,
  .welcome-actions .btn-secondary {
    width: auto;
    padding: 1rem 1.75rem;
  }

  /* ===== HERO RIGHT ===== */
  .hero-right {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mascot-glow {
    position: absolute;
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.18) 0%, transparent 60%);
    border-radius: 50%;
    z-index: 0;
  }

  .kidia-character {
    width: 100%;
    max-width: 440px;
    height: auto;
    position: relative;
    z-index: 1;
    animation: float 6s ease-in-out infinite;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3));
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  /* ===== TAGS ===== */
  .floating-tag {
    position: absolute;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 99px;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #e2e8f0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);
    animation: float 4s ease-in-out infinite;
  }

  .tag-1 { top: 10%; right: 10%; animation-delay: 0.5s; }
  .tag-2 { top: 50%; left: -5%; animation-delay: 1.2s; }
  .tag-3 { bottom: 15%; right: 5%; animation-delay: 0.8s; }

  /* ===== HERO: eyebrow / CTA row / trust strip ===== */
  .eyebrow {
    display: inline-block;
    background: rgba(232, 121, 249, 0.12);
    border: 1px solid rgba(232, 121, 249, 0.3);
    color: var(--color-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.9rem;
    border-radius: 99px;
    margin-bottom: 1.25rem;
    width: fit-content;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .hero-btn-primary {
    width: auto;
    padding: 1.1rem 1.75rem;
  }

  .hero-btn-ghost {
    width: auto;
    padding: 1.1rem 1.75rem;
    text-decoration: none;
  }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: 0.95rem;
    color: #cbd5e1;
  }

  /* ===== SCROLL CUE ===== */
  .scroll-cue {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.65rem;
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 99px;
    padding: 0.85rem 1.5rem;
    color: #e2e8f0;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    animation: scroll-cue-bounce 2.2s ease-in-out infinite;
    z-index: 3;
    box-shadow: 0 10px 30px -8px rgba(34, 211, 238, 0.25);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .scroll-cue:hover {
    color: var(--color-primary);
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 12px 36px -6px rgba(34, 211, 238, 0.4);
  }

  @keyframes scroll-cue-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ===== SHARED SECTION LAYOUT ===== */
  .section-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5%;
  }

  .section-header {
    text-align: center;
    margin: 0 auto 3.5rem;
  }

  .section-eyebrow {
    display: inline-block;
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 800;
