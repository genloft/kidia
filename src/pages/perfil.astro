---
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Perfil - Kidia</title>
  <style>
    body {
      margin: 0;
      font-family: 'Inter', system-ui, sans-serif;
      background-color: var(--color-bg);
      color: var(--color-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .profile-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      padding: 3rem 1rem;
    }

    .profile-card {
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.5rem;
      padding: 3rem;
      width: 100%;
      max-width: 600px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    h1 {
      font-size: 2.25rem;
      font-weight: 800;
      margin: 0 0 0.5rem 0;
      background: linear-gradient(135deg, #38bdf8, #818cf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .h1-small {
      font-size: 1.5rem;
    }

    .subtitle {
      color: #94a3b8;
      font-size: 1.05rem;
      margin-bottom: 2.5rem;
      line-height: 1.5;
    }

    .children-list {
      list-style: none;
      margin: 0 0 1.5rem 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .child-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 0.75rem;
      padding: 0.9rem 1.25rem;
    }

    .child-row .child-info strong {
      display: block;
      font-size: 1.05rem;
    }

    .child-row .child-info span {
      color: #94a3b8;
      font-size: 0.85rem;
    }

    .child-row .child-actions {
      display: flex;
      gap: 0.5rem;
    }

    .child-row button {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #e2e8f0;
      border-radius: 0.5rem;
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s;
    }

    .child-row button:hover {
      border-color: #38bdf8;
      color: #38bdf8;
    }

    .child-row button.btn-delete-child:hover {
      border-color: #f87171;
      color: #f87171;
    }

    .empty-children {
      color: #94a3b8;
      font-size: 0.95rem;
      text-align: center;
      padding: 1rem 0;
    }

    .add-child-form {
      display: grid;
      grid-template-columns: 2fr 1fr auto;
      gap: 1rem;
      align-items: end;
    }

    .add-child-form .btn-add-child {
      width: auto;
      padding: 0.9rem 1.5rem;
      margin-top: 0;
      white-space: nowrap;
    }

    @media (max-width: 600px) {
      .add-child-form {
        grid-template-columns: 1fr;
      }
    }

    .alert {
      padding: 1rem;
      border-radius: 0.75rem;
      margin-bottom: 2rem;
      font-weight: 500;
    }

    .alert.success {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      color: #4ade80;
    }

    .alert.error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      color: #f87171;
    }

    .form-section {
      margin-bottom: 2rem;
    }

    .form-section h3 {
      font-size: 1.25rem;
      margin: 0 0 1.25rem 0;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .input-group label {
      font-size: 0.9rem;
      font-weight: 600;
      color: #94a3b8;
    }

    .input-group input {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.9rem 1rem;
      border-radius: 0.75rem;
      color: white;
      font-size: 1rem;
      transition: all 0.2s;
      font-family: inherit;
    }

    .input-group input:focus {
      outline: none;
      border-color: #38bdf8;
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.1);
      background: rgba(15, 23, 42, 0.9);
    }

    .divider {
      height: 1px;
      background: rgba(255, 255, 255, 0.08);
      margin: 2.5rem 0;
    }

    .btn-save {
      width: 100%;
      padding: 1.15rem;
      background: linear-gradient(135deg, #0ea5e9, #6366f1);
      color: white;
      font-weight: 700;
      font-size: 1.1rem;
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.4);
      font-family: inherit;
      margin-top: 1rem;
    }

    .btn-save:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 25px -5px rgba(99, 102, 241, 0.5);
      background: linear-gradient(135deg, #38bdf8, #818cf8);
    }
    
    .spinner {
      animation: spin 1s linear infinite;
      margin-right: 0.5rem;
      display: none;
    }

    @keyframes spin {
      100% { transform: rotate(360deg); }
    }

    .hidden { display: none; }

    @media (max-width: 600px) {
      .form-grid {
        grid-template-columns: 1fr;
      }
      .profile-card {
        padding: 2rem 1.5rem;
      }
    }
  </style>
</head>
<body>
  <Header />
  
  <main class="profile-container">
    <div class="profile-card">
      <h1>Mi Perfil</h1>
      <p class="subtitle">Actualiza la información de tu cuenta para personalizar la experiencia en Kidia.</p>
      
      <div id="success-msg" class="alert success hidden"></div>
      <div id="error-msg" class="alert error hidden"></div>

      <form id="profile-form" class="profile-form">
        
        <!-- Cuenta -->
        <div class="form-section">
          <h3>⚙️ Datos de la Cuenta</h3>
          <div class="form-grid">
            <div class="input-group">
              <label>Correo Electrónico</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="input-group">
              <label>Nueva Contraseña (opcional)</label>
              <input type="password" id="password" name="password" placeholder="Dejar en blanco para no cambiar" minlength="6" />
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Tutor -->
        <div class="form-section">
          <h3>🧑 Datos del Padre / Tutor</h3>
          <div class="form-grid">
            <div class="input-group">
              <label>Nombre del Tutor/a</label>
              <input type="text" id="parent_name" name="parent_name" placeholder="Ej. María" />
            </div>
            <div class="input-group">
              <label>Fecha de Nacimiento</label>
              <input type="date" id="parent_dob" name="parent_dob" />
            </div>
          </div>
        </div>

        <button type="submit" class="btn-save">
          <svg class="spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
          </svg>
          <span class="btn-text">Guardar Cambios</span>
        </button>
      </form>
    </div>

    <div class="profile-card" id="hijos">
      <h1 class="h1-small">👦 Mis Hijos/as</h1>
      <p class="subtitle">Añade a cada hijo/a que vaya a usar Kidia. Cada uno tiene su propio progreso e inscripciones.</p>

      <div id="children-error" class="alert error hidden"></div>

      <ul id="children-list" class="children-list"></ul>

      <form id="add-child-form" class="add-child-form">
        <div class="input-group">
          <label>Nombre</label>
          <input type="text" id="new_child_name" placeholder="Ej. Leo" required />
        </div>
        <div class="input-group">
          <label>Fecha de nacimiento</label>
          <input type="date" id="new_child_dob" />
        </div>
        <button type="submit" class="btn-save btn-add-child">+ Añadir hijo/a</button>
      </form>
    </div>
  </main>
</body>
</html>

<script>
  import { supabase } from '../lib/supabase';
  import { ChildrenService, type Child } from '../lib/children-service';
  import { calcAge, tramoForAge } from '../lib/tramos';

  let currentUserId = '';
  let currentUserEmail = '';

  const form = document.getElementById('profile-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const submitBtn = form.querySelector('.btn-save') as HTMLButtonElement;

  async function loadProfile() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      window.location.href = '/login';
      return;
    }

    currentUserId = session.user.id;
    currentUserEmail = session.user.email || '';

    (document.getElementById('email') as HTMLInputElement).value = currentUserEmail;

    const { data: profile } = await supabase
      .from('user_profiles')
      .select('parent_name, parent_dob')
      .eq('id', currentUserId)
      .single();

    if (profile) {
      if (profile.parent_name) (document.getElementById('parent_name') as HTMLInputElement).value = profile.parent_name;
      if (profile.parent_dob) (document.getElementById('parent_dob') as HTMLInputElement).value = profile.parent_dob;
    }
  }

  loadProfile();
  loadChildren();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
    const spinner = submitBtn.querySelector('.spinner') as HTMLElement;
    btnText.textContent = 'Guardando...';
    spinner.style.display = 'inline-block';

    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;
    const parent_name = formData.get('parent_name') as string;
    const parent_dob = formData.get('parent_dob') as string;

    let errorText = '';
    let successText = '';
    let authUpdated = false;

    // Actualizar Auth
    if (password) {
      const { error } = await supabase.auth.updateUser({ password });
      if (error) errorText += `Error en contraseña: ${error.message}. `;
      else authUpdated = true;
    }

    if (email && email !== currentUserEmail) {
      const { error } = await supabase.auth.updateUser({ email });
      if (error) errorText += `Error en email: ${error.message}. `;
      else authUpdated = true;
    }

    // Actualizar Perfil
    const { error: dbError } = await supabase
      .from('user_profiles')
      .update({
        parent_name: parent_name || null,
        parent_dob: parent_dob || null
      })
      .eq('id', currentUserId);

    if (dbError) {
      errorText += 'Error al guardar el perfil. Asegúrate de ejecutar el código SQL en Supabase.';
      console.error(dbError);
    }

    submitBtn.disabled = false;
    btnText.textContent = 'Guardar Cambios';
    spinner.style.display = 'none';

    if (errorText) {
      errorMsg.textContent = errorText;
      errorMsg.classList.remove('hidden');
    } else {
      successText = 'Perfil actualizado correctamente.';
      if (authUpdated) successText += ' Si cambiaste tu correo, revisa tu bandeja de entrada.';
      successMsg.textContent = successText;
      successMsg.classList.remove('hidden');
    }
  });

  // ---- Gestión de hijos/as ----

  const childrenList = document.getElementById('children-list') as HTMLUListElement;
  const childrenError = document.getElementById('children-error') as HTMLElement;
  const addChildForm = document.getElementById('add-child-form') as HTMLFormElement;

  function childMeta(birthDate: string | null): string {
    if (!birthDate) return '';
    const age = calcAge(birthDate);
    const tramo = tramoForAge(age);
    return `${age} años${tramo ? ' · Tramo ' + tramo.id : ''}`;
  }

  function renderChildren(children: Child[]) {
    if (children.length === 0) {
      childrenList.innerHTML = '<li class="empty-children">Todavía no has añadido ningún hijo/a.</li>';
      return;
    }

    childrenList.innerHTML = children.map(c => `
      <li class="child-row" data-id="${c.id}">
        <div class="child-info">
          <strong>${escapeHtml(c.name)}</strong>
          <span>${childMeta(c.birth_date)}</span>
        </div>
        <div class="child-actions">
          <button type="button" class="btn-delete-child" data-id="${c.id}">Eliminar</button>
        </div>
      </li>
    `).join('');

    childrenList.querySelectorAll('.btn-delete-child').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id!;
        if (!confirm('¿Seguro que quieres eliminar a este hijo/a? Se perderá su progreso e inscripciones.')) return;
        const { error } = await ChildrenService.deleteChild(id);
        if (error) {
          childrenError.textContent = error;
          childrenError.classList.remove('hidden');
        } else {
          loadChildren();
        }
      });
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  async function loadChildren() {
    const children = await ChildrenService.listChildren();
    renderChildren(children);
  }

  addChildForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    childrenError.classList.add('hidden');

    const nameInput = document.getElementById('new_child_name') as HTMLInputElement;
    const dobInput = document.getElementById('new_child_dob') as HTMLInputElement;

    const { error } = await ChildrenService.addChild(nameInput.value.trim(), dobInput.value || null);
    if (error) {
      childrenError.textContent = error;
      childrenError.classList.remove('hidden');
      return;
    }

    nameInput.value = '';
    dobInput.value = '';
    loadChildren();
  });
</script>
