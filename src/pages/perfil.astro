---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Mi Perfil - Kidia" description="Actualiza tus datos de cuenta y gestiona los hijos/as inscritos en Kidia.">
  <style>
    .profile-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 2rem 4rem;
    }

    .profile-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .profile-header h1 {
      font-size: 2.25rem;
      margin-bottom: 0.5rem;
    }

    .profile-header p {
      max-width: 560px;
      margin: 0 auto;
    }

    /* Una sola tarjeta (la gestión de hijos/as vive ahora en el Panel
       Familiar): columna centrada en vez del grid a dos columnas. */
    .profile-grid {
      max-width: 720px;
      margin: 0 auto;
    }

    /* Hasta pasar el gate del Modo Familia no se enseña el contenido. */
    .profile-container.familia-locked {
      visibility: hidden;
    }

    .profile-card {
      background: var(--k-bg-surface);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-lg);
      padding: 2.25rem;
      box-shadow: var(--shadow-lg);
    }

    .profile-card h2 {
      font-size: 1.4rem;
      margin: 0 0 0.5rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .profile-card > p {
      font-size: 0.95rem;
      margin-bottom: 1.75rem;
      line-height: 1.5;
    }

    .panel-link {
      text-align: center;
      color: var(--k-text-muted);
      margin-top: 1.5rem;
    }

    .panel-link a {
      color: var(--k-brand-primary);
      text-decoration: underline;
    }

    .alert {
      padding: 1rem;
      border-radius: 0.75rem;
      margin-bottom: 2rem;
      font-weight: 500;
    }

    .alert.success {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      color: var(--k-state-success);
    }

    .alert.error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.2);
      color: var(--k-state-danger);
    }

    .form-section {
      margin-bottom: 2rem;
    }

    .form-section h3 {
      font-size: 1.25rem;
      margin: 0 0 1.25rem 0;
      color: var(--k-text-body);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .input-group label {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--k-text-muted);
    }

    .input-group input {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.9rem 1rem;
      border-radius: 0.75rem;
      color: white;
      font-size: 1rem;
      transition: all 0.2s;
      font-family: inherit;
    }

    .input-group input:focus {
      outline: none;
      border-color: var(--k-brand-primary);
      box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.12);
      background: rgba(15, 23, 42, 0.9);
    }

    .divider {
      height: 1px;
      background: rgba(255, 255, 255, 0.08);
      margin: 2.5rem 0;
    }

    .btn-save {
      width: 100%;
      padding: 1.15rem;
      background: linear-gradient(135deg, var(--k-brand-primary), var(--k-brand-accent));
      color: var(--k-text-inverse);
      font-weight: 700;
      font-size: 1.1rem;
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 10px 20px -5px rgba(34, 211, 238, 0.35);
      font-family: inherit;
      margin-top: 1rem;
    }

    .btn-save:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 25px -5px rgba(34, 211, 238, 0.5);
      filter: brightness(1.08);
    }
    
    .spinner {
      animation: spin 1s linear infinite;
      margin-right: 0.5rem;
      display: none;
    }

    @keyframes spin {
      100% { transform: rotate(360deg); }
    }

    .hidden { display: none; }

    @media (max-width: 600px) {
      .form-grid {
        grid-template-columns: 1fr;
      }
      .profile-card {
        padding: 2rem 1.5rem;
      }
    }
  </style>

  <Header mode="familia" />

  <main class="profile-container familia-locked" id="perfil-main">
    <div class="profile-header">
      <h1 class="text-gradient">Mi Cuenta</h1>
      <p>Actualiza tu correo, contraseña y datos de tutor/a. El progreso y la gestión de tus hijos/as están en el <a href="/parents">Panel Familiar</a>.</p>
    </div>

    <div class="profile-grid">
      <div class="profile-card">
        <h2>⚙️ Datos de la Cuenta</h2>
        <p>Tu correo y contraseña de acceso a Kidia.</p>

        <div id="success-msg" class="alert success hidden"></div>
        <div id="error-msg" class="alert error hidden"></div>

        <form id="profile-form" class="profile-form">

          <!-- Cuenta -->
          <div class="form-section">
            <div class="form-grid">
              <div class="input-group">
                <label>Correo Electrónico</label>
                <input type="email" id="email" name="email" required />
              </div>
              <div class="input-group">
                <label>Nueva Contraseña (opcional)</label>
                <input type="password" id="password" name="password" placeholder="Dejar en blanco para no cambiar" minlength="6" />
              </div>
            </div>
          </div>

          <div class="divider"></div>

          <!-- Tutor -->
          <div class="form-section">
            <h3>🧑 Datos del Padre / Tutor</h3>
            <div class="form-grid">
              <div class="input-group">
                <label>Nombre del Tutor/a</label>
                <input type="text" id="parent_name" name="parent_name" placeholder="Ej. María" />
              </div>
              <div class="input-group">
                <label>Fecha de Nacimiento</label>
                <input type="date" id="parent_dob" name="parent_dob" />
              </div>
            </div>
          </div>

          <button type="submit" class="btn-save">
            <svg class="spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            <span class="btn-text">Guardar Cambios</span>
          </button>
        </form>
      </div>

    </div>

    <p class="panel-link">¿Buscabas a tus hijos/as? Se gestionan desde el <a href="/parents">Panel Familiar 🛡️</a>.</p>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { FamiliaGate } from '../lib/familia-gate';

  let currentUserId = '';
  let currentUserEmail = '';

  const form = document.getElementById('profile-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg') as HTMLElement;
  const errorMsg = document.getElementById('error-msg') as HTMLElement;
  const submitBtn = form.querySelector('.btn-save') as HTMLButtonElement;

  async function loadProfile() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      window.location.href = '/login';
      return;
    }

    // Página del Modo Familia: con PIN activo, pide el gate antes de
    // enseñar nada (si se cancela, redirige al Mapa).
    const pass = await FamiliaGate.requireFamiliaAccess();
    if (!pass) return;
    document.getElementById('perfil-main')?.classList.remove('familia-locked');

    currentUserId = session.user.id;
    currentUserEmail = session.user.email || '';

    (document.getElementById('email') as HTMLInputElement).value = currentUserEmail;

    const { data: profile } = await supabase
      .from('user_profiles')
      .select('parent_name, parent_dob')
      .eq('id', currentUserId)
      .single();

    if (profile) {
      if (profile.parent_name) (document.getElementById('parent_name') as HTMLInputElement).value = profile.parent_name;
      if (profile.parent_dob) (document.getElementById('parent_dob') as HTMLInputElement).value = profile.parent_dob;
    }
  }

  loadProfile();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
    const spinner = submitBtn.querySelector('.spinner') as HTMLElement;
    btnText.textContent = 'Guardando...';
    spinner.style.display = 'inline-block';

    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;
    const parent_name = formData.get('parent_name') as string;
    const parent_dob = formData.get('parent_dob') as string;

    let errorText = '';
    let successText = '';
    let authUpdated = false;

    // Actualizar Auth
    if (password) {
      const { error } = await supabase.auth.updateUser({ password });
      if (error) errorText += `Error en contraseña: ${error.message}. `;
      else authUpdated = true;
    }

    if (email && email !== currentUserEmail) {
      const { error } = await supabase.auth.updateUser({ email });
      if (error) errorText += `Error en email: ${error.message}. `;
      else authUpdated = true;
    }

    // Actualizar Perfil
    const { error: dbError } = await supabase
      .from('user_profiles')
      .update({
        parent_name: parent_name || null,
        parent_dob: parent_dob || null
      })
      .eq('id', currentUserId);

    if (dbError) {
      errorText += 'Error al guardar el perfil. Asegúrate de ejecutar el código SQL en Supabase.';
      console.error(dbError);
    }

    submitBtn.disabled = false;
    btnText.textContent = 'Guardar Cambios';
    spinner.style.display = 'none';

    if (errorText) {
      errorMsg.textContent = errorText;
      errorMsg.classList.remove('hidden');
    } else {
      successText = 'Perfil actualizado correctamente.';
      if (authUpdated) successText += ' Si cambiaste tu correo, revisa tu bandeja de entrada.';
      successMsg.textContent = successText;
      successMsg.classList.remove('hidden');
    }
  });

  // La gestión de hijos/as vive en el Panel Familiar (/parents).
</script>
