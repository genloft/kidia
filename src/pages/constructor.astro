---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ConstructorApp from '../features/constructor/ConstructorApp.svelte';
import '../styles/constructor.css';
---

<Layout title="Constructor - Kidia" description="Construye tu propia Inteligencia Artificial pieza a pieza en el Constructor de Kidia: datos, cerebro, entrenamiento y examen, en un juego pensado para niños." showFooter={false}>
  <Header mode="aventura" />
  <!-- El componente Svelte debe renderizarse en el cliente para su interactividad -->
  <ConstructorApp client:only="svelte" />
</Layout>

<script>
  import { requireActiveChild } from '../lib/require-auth';
  import { SubscriptionService } from '../lib/subscription-service';

  requireActiveChild().then(async (allowed) => {
    if (!allowed) return;
    const hasPlan = await SubscriptionService.hasActivePlan();
    if (!hasPlan) window.location.href = '/caminos';
  });
</script>
