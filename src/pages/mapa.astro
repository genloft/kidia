---
// Mapa de Misiones v2 — "mapa de zonas" (docs/mejora/02 §2.3 y 04 §3.2).
// Vertical y touch-first: las 4 zonas del método como secciones con camino,
// sin drag de ratón, sin tilt 3D ni tooltips-hover. Cada tramo tiene su
// panel; el del hijo activo se muestra en cliente (data-tramo-panel).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProgressBar from '../components/ui/ProgressBar.astro';
import { loadScenarios, loadUnidadesAventura, loadMisionesEspeciales } from '../lib/scenario-loader';

// --- Tramo 8-9: 16 unidades-aventura agrupadas en 4 zonas + especiales ---
const unidades = await loadUnidadesAventura('8-9');
const especiales = await loadMisionesEspeciales('8-9');
const especialPorNivel = new Map(especiales.map(m => [m.nivel, m]));

const zonas89 = [1, 2, 3, 4].map(nivel => {
  const delNivel = unidades.filter(u => u.nivel === nivel);
  return {
    nivel,
    nombre: delNivel[0]?.zona.nombre ?? `Zona ${nivel}`,
    unidades: delNivel,
    especial: especialPorNivel.get(nivel as 1 | 2 | 3 | 4) ?? null,
  };
});

// --- Tramos 10-11 y 12-14: migración incremental a unidad-aventura (Fase 4,
// desde los docx del método). Cada parada del mapa es o una unidad migrada
// (formato nuevo) o un reto legacy aún sin migrar; se agrupan por nivel en
// secciones de zona, con el nombre real del nivel del método si hay unidades
// migradas que lo aporten (zona.nombre).
const scenarios = await loadScenarios('es');

interface ParadaLegacy {
  tipo: 'legacy';
  scenario: (typeof scenarios)[number];
  reqUnidadMigrada?: string;
}
interface ParadaMigrada {
  tipo: 'migrada';
  unidad: Awaited<ReturnType<typeof loadUnidadesAventura>>[number];
}
type Parada = ParadaLegacy | ParadaMigrada;

const panelesLegacy = await Promise.all((['10-11', '12-14'] as const).map(async tramo => {
  const migradas = await loadUnidadesAventura(tramo);
  const migradasPorUnidad = new Map(migradas.map(u => [u.id, u]));
  const delTramo = scenarios.filter(s => s.tramo === tramo);

  // Paradas: todas las unidades migradas + los legacy cuya unidad NO migró.
  const paradas: Parada[] = [
    ...migradas.map(u => ({ tipo: 'migrada', unidad: u } as ParadaMigrada)),
    ...delTramo
      .filter(s => !(s.unidad && migradasPorUnidad.has(s.unidad)))
      .map(s => {
        // Si el reto ANTERIOR de la cadena está migrado, su insignia legacy
        // ya no se otorga: la tarjeta pasa a desbloquearse por "unidad
        // migrada completada" (data-req-unidad), manteniendo la insignia
        // vieja como llave alternativa para quien ya la tuviera ganada.
        const requisitoDe = s.required_badge_id
          ? delTramo.find(x => x.badge.id === s.required_badge_id)
          : undefined;
        const reqUnidadMigrada = requisitoDe?.unidad && migradasPorUnidad.has(requisitoDe.unidad)
          ? requisitoDe.unidad
          : undefined;
        return { tipo: 'legacy', scenario: s, reqUnidadMigrada } as ParadaLegacy;
      }),
  ].sort((a, b) => {
    const ua = a.tipo === 'migrada' ? a.unidad.id : (a.scenario.unidad ?? '99');
    const ub = b.tipo === 'migrada' ? b.unidad.id : (b.scenario.unidad ?? '99');
    return parseFloat(ua) - parseFloat(ub);
  });

  // Secciones por nivel (1-4), con el nombre de zona que aporten las migradas.
  const niveles = [...new Set(paradas.map(p => p.tipo === 'migrada' ? p.unidad.nivel : (p.scenario.nivel ?? 1)))].sort();
  const secciones = niveles.map(nivel => {
    const delNivel = paradas.filter(p => (p.tipo === 'migrada' ? p.unidad.nivel : (p.scenario.nivel ?? 1)) === nivel);
    const nombreZona = delNivel.find((p): p is ParadaMigrada => p.tipo === 'migrada')?.unidad.zona.nombre ?? `Nivel ${nivel}`;
    return { nivel, nombreZona, paradas: delNivel };
  });

  return { tramo, secciones };
}));
---

<Layout title="Kidia - Mapa de Misiones" description="El Mapa de Misiones de Kidia: avanza por las zonas del laboratorio completando misiones para aprender IA a tu ritmo." showFooter={false}>
  <Header mode="aventura" />

  <main class="mapa">
    <header class="mapa-head">
      <div class="mapa-title-row">
        <h1>Mapa de Misiones</h1>
        <span id="map-tramo-pill" class="k-pill k-pill--accent hidden"></span>
      </div>
      <p class="mapa-sub">Avanza por las zonas del laboratorio: cada misión completada ilumina el camino.</p>
      <div class="mapa-progress">
        <span class="mapa-progress-label">Progreso</span>
        <ProgressBar value={0} fillId="global-bar" label="Progreso global" class="mapa-progress-bar" />
        <strong id="global-percent">0%</strong>
      </div>
    </header>

    <!-- ============ Panel tramo 8-9 (unidades-aventura) ============ -->
    <div data-tramo-panel="8-9" class="tramo-panel hidden">
      {zonas89.map(zona => (
        <section class="zona" style={`--zona-accent: var(--k-zona-${zona.nivel})`}>
          <header class="zona-head">
            <span class="zona-num" aria-hidden="true">{zona.nivel}</span>
            <div class="zona-head-text">
              <h2>{zona.nombre}</h2>
              <span class="zona-count k-pill" data-zona-count>· / ·</span>
            </div>
          </header>

          <ol class="zona-path">
            {zona.unidades.map(u => (
              <li>
                <a
                  class="mision-card"
                  href={`/laboratorio/${u.id}`}
                  data-id={u.id}
                  data-unidad={u.id}
                  data-badge={u.comparte.insigniaPosible?.id}
                >
                  <span class="mision-num" aria-hidden="true">{u.id}</span>
                  <span class="mision-body">
                    <h3>{u.titulo}</h3>
                    <p>{u.mision.textoVael}</p>
                  </span>
                  <span class="k-pill mision-pill" data-pill>…</span>
                </a>
              </li>
            ))}
            {zona.especial && (
              <li>
                <a
                  class="mision-card mision-card--especial"
                  href={`/laboratorio/especial/${zona.especial.id}`}
                  data-id={zona.especial.id}
                  data-unidad={`${zona.nivel}.especial`}
                >
                  <span class="mision-num" aria-hidden="true">🔭</span>
                  <span class="mision-body">
                    <h3>{zona.especial.titulo}</h3>
                    <p>Cierra la {zona.nombre} con una misión corta de 5-7 minutos. No es un examen.</p>
                  </span>
                  <span class="k-pill mision-pill" data-pill>…</span>
                </a>
              </li>
            )}
          </ol>
        </section>
      ))}
    </div>

    <!-- ==== Paneles tramos 10-11 y 12-14 (migración incremental + legacy) ==== -->
    {panelesLegacy.map(panel => (
      <div data-tramo-panel={panel.tramo} class="tramo-panel hidden">
        {panel.secciones.map(seccion => (
          <section class="zona" style={`--zona-accent: var(--k-zona-${seccion.nivel})`}>
            <header class="zona-head">
              <span class="zona-num" aria-hidden="true">{seccion.nivel}</span>
              <div class="zona-head-text">
                <h2>{seccion.nombreZona}</h2>
                <span class="zona-count k-pill" data-zona-count>· / ·</span>
              </div>
            </header>

            <ol class="zona-path">
              {seccion.paradas.map(parada => (
                <li>
                  {parada.tipo === 'migrada' ? (
                    <a
                      class="mision-card"
                      href={`/laboratorio/${panel.tramo}/${parada.unidad.id}`}
                      data-id={parada.unidad.id}
                      data-unidad={parada.unidad.id}
                    >
                      <span class="mision-num" aria-hidden="true">{parada.unidad.id}</span>
                      <span class="mision-body">
                        <h3>{parada.unidad.titulo}</h3>
                        <p>{parada.unidad.mision.textoVael}</p>
                      </span>
                      <span class="k-pill mision-pill" data-pill>…</span>
                    </a>
                  ) : (
                    <a
                      class="mision-card"
                      href={`/scenario/${parada.scenario.id}`}
                      data-id={parada.scenario.id}
                      data-unidad={parada.scenario.unidad}
                      data-badge={parada.scenario.badge?.id}
                      data-req={parada.scenario.required_badge_id}
                      data-req-unidad={parada.reqUnidadMigrada}
                    >
                      <span class="mision-num" aria-hidden="true">{parada.scenario.unidad}</span>
                      <span class="mision-body">
                        <h3>{parada.scenario.title.replace(/^[\d.]+\s*/, '')}</h3>
                        <p>{parada.scenario.description}</p>
                      </span>
                      <span class="k-pill mision-pill" data-pill>…</span>
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    ))}
  </main>
</Layout>

<script>
  import { ProgressService } from '../lib/progress-service';
  import { activeChild } from '../lib/active-child';
  import { SubscriptionService } from '../lib/subscription-service';
  import { ChildrenService } from '../lib/children-service';
  import { tramoForChild } from '../lib/tramos';
  import { requireActiveChild } from '../lib/require-auth';

  type PillVariant = 'success' | 'warning' | 'locked' | 'accent' | '';

  function setPill(card: Element, text: string, variant: PillVariant) {
    const pill = card.querySelector('[data-pill]');
    if (!pill) return;
    pill.textContent = text;
    pill.className = `k-pill mision-pill${variant ? ` k-pill--${variant}` : ''}`;
  }

  async function init() {
    const allowed = await requireActiveChild();
    if (!allowed) return;

    const state = ProgressService.getState();
    const childId = activeChild.get();

    let myTramo: string | null = null;
    let hasPlan = false;

    if (childId) {
      hasPlan = await SubscriptionService.hasActivePlan();
      const children = await ChildrenService.listChildren();
      const child = children.find(c => c.id === childId);
      if (child) {
        const tramo = tramoForChild(child.birth_date);
        myTramo = tramo ? tramo.id : null;
        const tramoPill = document.getElementById('map-tramo-pill');
        if (tramo && tramoPill) {
          tramoPill.textContent = `Tramo ${tramo.label}`;
          tramoPill.classList.remove('hidden');
        }
      }
    }

    // Mostrar solo el panel del tramo del hijo activo (8-9 por defecto).
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-tramo-panel]'));
    const target = panels.some(p => p.dataset.tramoPanel === myTramo) ? myTramo : '8-9';
    panels.forEach(p => p.classList.toggle('hidden', p.dataset.tramoPanel !== target));
    const panel = panels.find(p => p.dataset.tramoPanel === target);
    if (!panel) return;

    // Estados de cada tarjeta de misión.
    const cards = Array.from(panel.querySelectorAll<HTMLAnchorElement>('.mision-card'));
    let teTocaAsignado = false;
    let completadas = 0;

    cards.forEach(card => {
      const id = card.dataset.id || '';
      const unidad = card.dataset.unidad || '';
      const reqBadge = card.dataset.req;
      const badgeId = card.dataset.badge;

      const isCompleted = state.completedScenarios.includes(id);
      // "Completada" (flujo terminado) y "ganada" (insignia real tras el test)
      // son distintas en los retos legacy — ver Quiz.astro.
      const isEarned = badgeId ? state.badges.includes(badgeId) : isCompleted;

      let locked = Boolean(reqBadge && !state.badges.includes(reqBadge));
      // El reto anterior está migrado a unidad-aventura (sin insignia legacy):
      // completar la unidad nueva también abre esta tarjeta; la insignia
      // vieja sigue valiendo como llave para quien ya la tuviera.
      const reqUnidad = card.dataset.reqUnidad;
      if (locked && reqUnidad && state.completedScenarios.includes(reqUnidad)) {
        locked = false;
      }
      let needsSubscription = false;
      if (!hasPlan && unidad !== '1.1') {
        locked = true;
        needsSubscription = true;
      }

      card.classList.remove('completada', 'bloqueada', 'es-aqui', 'pendiente-test');

      if (isEarned) {
        completadas++;
        card.classList.add('completada');
        setPill(card, '✅ Completada', 'success');
      } else if (isCompleted) {
        // Terminó el reto pero no aprobó (o no hizo) el test → no cuenta aún.
        card.classList.add('pendiente-test');
        setPill(card, '📝 Termina el test', 'warning');
      } else if (locked) {
        card.classList.add('bloqueada');
        if (needsSubscription) {
          card.setAttribute('href', '/caminos');
          setPill(card, '🔒 Con suscripción', 'locked');
        } else {
          card.removeAttribute('href');
          setPill(card, '🔒 Bloqueada', 'locked');
        }
      } else if (!teTocaAsignado) {
        teTocaAsignado = true;
        card.classList.add('es-aqui');
        setPill(card, '⭐ ¡Te toca!', '');
      } else {
        setPill(card, '🚀 Disponible', '');
      }
    });

    // Contador por zona ("3 de 5") y zona completa.
    panel.querySelectorAll<HTMLElement>('.zona').forEach(zona => {
      const zonaCards = zona.querySelectorAll('.mision-card');
      const done = zona.querySelectorAll('.mision-card.completada').length;
      const countEl = zona.querySelector('[data-zona-count]');
      if (countEl) countEl.textContent = `${done} de ${zonaCards.length}`;
      zona.classList.toggle('zona--completa', done === zonaCards.length && zonaCards.length > 0);
    });

    // Progreso global del tramo visible.
    const percent = cards.length ? Math.min(100, Math.round((completadas / cards.length) * 100)) : 0;
    const bar = document.getElementById('global-bar');
    const text = document.getElementById('global-percent');
    if (bar) bar.style.width = `${percent}%`;
    if (text) text.textContent = `${percent}%`;

    // Llevar la vista a "te toca" solo si queda FUERA de la pantalla (retomar
    // donde estaba). Antes se centraba en cada carga aunque la tarjeta ya
    // fuera visible, lo que daba un tirón brusco al abrir el mapa; ahora solo
    // se desplaza cuando de verdad hace falta.
    if (completadas > 0) {
      const teToca = panel.querySelector('.es-aqui') as HTMLElement | null;
      if (teToca) {
        const rect = teToca.getBoundingClientRect();
        const fueraDeVista = rect.top < 90 || rect.bottom > window.innerHeight;
        if (fueraDeVista) teToca.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    }
  }

  init();
</script>

<style>
  .mapa {
    max-width: 860px;
    margin: 0 auto;
    padding: var(--k-space-8) var(--k-space-4) var(--k-space-24);
  }

  /* ---------- Cabecera ---------- */

  .mapa-head {
    margin-bottom: var(--k-space-12);
  }

  .mapa-title-row {
    display: flex;
    align-items: center;
    gap: var(--k-space-3);
    flex-wrap: wrap;
  }

  .mapa-title-row h1 {
    background: linear-gradient(135deg, var(--k-brand-primary), var(--k-brand-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  #map-tramo-pill.hidden {
    display: none;
  }

  .mapa-sub {
    margin: var(--k-space-2) 0 var(--k-space-5);
    max-width: 55ch;
  }

  .mapa-progress {
    display: flex;
    align-items: center;
    gap: var(--k-space-3);
    max-width: 420px;
  }

  .mapa-progress-label {
    font-size: var(--k-text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--k-text-muted);
  }

  .mapa-progress :global(.mapa-progress-bar) {
    flex: 1;
  }

  #global-percent {
    color: var(--k-brand-primary);
    font-weight: 800;
    min-width: 3ch;
    text-align: right;
  }

  .tramo-panel.hidden {
    display: none;
  }

  /* ---------- Zona ---------- */

  .zona {
    margin-bottom: var(--k-space-16);
  }

  .zona-head {
    display: flex;
    align-items: center;
    gap: var(--k-space-4);
    margin-bottom: var(--k-space-6);
  }

  .zona-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    font-size: var(--k-text-xl);
    font-weight: 800;
    color: var(--zona-accent);
    background: color-mix(in srgb, var(--zona-accent) 14%, transparent);
    border: 2px solid color-mix(in srgb, var(--zona-accent) 45%, transparent);
  }

  .zona-head-text {
    display: flex;
    align-items: center;
    gap: var(--k-space-3);
    flex-wrap: wrap;
  }

  .zona-head-text h2 {
    color: var(--k-text-strong);
  }

  .zona-count {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--k-border-subtle);
    color: var(--k-text-muted);
  }

  .zona--completa .zona-num {
    background: color-mix(in srgb, var(--k-state-success) 15%, transparent);
    border-color: var(--k-state-success);
    color: var(--k-state-success);
  }

  .zona--completa .zona-count {
    color: var(--k-state-success);
    border-color: color-mix(in srgb, var(--k-state-success) 40%, transparent);
  }

  /* ---------- Camino de misiones ---------- */

  .zona-path {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--k-space-10);
    position: relative;
  }

  /* Línea vertical del camino */
  .zona-path::before {
    content: '';
    position: absolute;
    left: 17px;
    top: var(--k-space-2);
    bottom: var(--k-space-2);
    width: 3px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--zona-accent) 30%, transparent);
  }

  .zona-path li {
    position: relative;
    margin-bottom: var(--k-space-4);
  }

  /* Nodo del camino */
  .zona-path li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--k-space-10) + 12px);
    top: 50%;
    transform: translateY(-50%);
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--k-bg-page);
    border: 3px solid color-mix(in srgb, var(--zona-accent) 55%, transparent);
  }

  .zona-path li:has(.completada)::before {
    background: var(--zona-accent);
    border-color: var(--zona-accent);
  }

  .zona-path li:has(.es-aqui)::before {
    background: var(--k-brand-primary);
    border-color: var(--k-brand-primary);
    box-shadow: 0 0 12px rgba(34, 211, 238, 0.8);
  }

  /* ---------- Tarjeta de misión ---------- */

  .mision-card {
    display: flex;
    align-items: center;
    gap: var(--k-space-4);
    background: var(--k-bg-surface);
    border: 1px solid var(--k-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--k-space-4) var(--k-space-5);
    transition:
      transform var(--k-motion-base) var(--k-ease-out),
      border-color var(--k-motion-base) var(--k-ease-out),
      box-shadow var(--k-motion-base) var(--k-ease-out);
  }

  a.mision-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--zona-accent) 50%, transparent);
    box-shadow: var(--shadow-md);
  }

  .mision-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    font-weight: 800;
    font-size: var(--k-text-sm);
    color: var(--zona-accent);
    background: color-mix(in srgb, var(--zona-accent) 12%, transparent);
  }

  .mision-body {
    flex: 1;
    min-width: 0;
  }

  .mision-body h3 {
    font-size: var(--k-text-lg);
    color: var(--k-text-strong);
    margin-bottom: 2px;
  }

  .mision-body p {
    margin: 0;
    font-size: var(--k-text-sm);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mision-pill {
    flex-shrink: 0;
  }

  /* Estados */
  .mision-card.completada {
    border-color: color-mix(in srgb, var(--k-state-success) 35%, transparent);
  }

  .mision-card.es-aqui {
    border-color: var(--k-brand-primary);
    box-shadow: var(--k-glow-primary);
  }

  .mision-card.bloqueada {
    opacity: 0.6;
  }

  .mision-card.bloqueada:not([href]) {
    cursor: default;
  }

  a.mision-card.bloqueada:not([href]):hover {
    transform: none;
    box-shadow: none;
    border-color: var(--k-border-subtle);
  }

  .mision-card--especial {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--zona-accent) 45%, transparent);
    background: color-mix(in srgb, var(--zona-accent) 6%, var(--k-bg-surface));
  }

  /* ---------- Móvil ---------- */

  @media (max-width: 600px) {
    .mapa {
      padding-top: var(--k-space-6);
    }

    .zona-path {
      padding-left: var(--k-space-6);
    }

    .zona-path::before {
      left: 5px;
    }

    .zona-path li::before {
      left: calc(-1 * var(--k-space-6));
    }

    .mision-card {
      flex-wrap: wrap;
      gap: var(--k-space-3);
    }

    .mision-body {
      flex-basis: calc(100% - 44px - var(--k-space-3));
    }

    .mision-pill {
      margin-left: calc(44px + var(--k-space-3));
    }
  }
</style>
