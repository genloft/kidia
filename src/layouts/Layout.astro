---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	// false en pantallas de app a pantalla completa (mapa, reto, constructor,
	// dashboard) donde el pie de página rompería el layout de altura fija.
	showFooter?: boolean;
}

const { title, description = 'Kidia - Aprende IA con tu amiga virtual', showFooter = true } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="bg-fx" aria-hidden="true">
			<div class="bg-fx-grid"></div>
			<div class="bg-fx-blob bg-fx-blob-1"></div>
			<div class="bg-fx-blob bg-fx-blob-2"></div>
			<div class="bg-fx-blob bg-fx-blob-3"></div>
		</div>
		<slot />
		{showFooter && <Footer />}
		<CookieBanner />
	</body>
</html>

<style>
	/* Fondo técnico sutil: rejilla + manchas de color muy transparentes,
	   fijas respecto al viewport (no se desplazan con el scroll) para dar
	   profundidad sin competir con el contenido. */
	.bg-fx {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	.bg-fx-grid {
		position: absolute;
		inset: -10%;
		background-image:
			linear-gradient(rgba(148, 163, 184, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(148, 163, 184, 0.06) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: radial-gradient(circle at 50% 20%, black 0%, transparent 65%);
		-webkit-mask-image: radial-gradient(circle at 50% 20%, black 0%, transparent 65%);
	}

	.bg-fx-blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(120px);
	}

	.bg-fx-blob-1 {
		width: 55vw;
		height: 55vw;
		top: -18%;
		left: -12%;
		background: radial-gradient(circle, rgba(34, 211, 238, 0.16), transparent 70%);
	}

	.bg-fx-blob-2 {
		width: 50vw;
		height: 50vw;
		top: 20%;
		right: -16%;
		background: radial-gradient(circle, rgba(139, 92, 246, 0.14), transparent 70%);
	}

	.bg-fx-blob-3 {
		width: 45vw;
		height: 45vw;
		bottom: -12%;
		left: 15%;
		background: radial-gradient(circle, rgba(232, 121, 249, 0.1), transparent 70%);
	}
</style>
