---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path ? 'active' : '';
---

<header class="header">
  <div class="logo">
    <a href="/">
      <span class="logo-text">Kidia</span>
      <span class="logo-beta">beta</span>
    </a>
  </div>

  <nav class="main-nav">
    <a href="/mapa" class={`nav-link ${isActive('/mapa')}`}>Mapa</a>
    <a href="/insignias" class={`nav-link ${isActive('/insignias')}`}>Insignias</a>
    <a href="/constructor" class={`nav-link ${isActive('/constructor')}`}>Constructor</a>
    <a href="/caminos" class={`nav-link ${isActive('/caminos')}`}>Caminos</a>
    <a href="/metodologia" class={`nav-link ${isActive('/metodologia')}`}>Metodología</a>
    <a href="/blog" class={`nav-link ${isActive('/blog')}`}>Blog</a>
    <a href="/about" class={`nav-link ${isActive('/about')}`}>Info</a>
  </nav>

  <div class="right-cluster">
      <div id="parent-zone-guest" class="parent-zone">
          <a href="/parents" class={`nav-link parent-link ${isActive('/parents')}`}>Zona Padres 🔒</a>
      </div>
      <div id="auth-loading" class="auth-loading">
          <div class="skeleton-btn"></div>
      </div>
      <div id="auth-ui" style="display: none; opacity: 0; transition: opacity 0.3s ease;">
          <a href="/login" class="btn-login">Acceder</a>
      </div>
  </div>
</header>

<script>
    import { supabase } from '../lib/supabase';
    import { SyncService } from '../lib/sync-service';
    
    const authUi = document.getElementById('auth-ui');
    
    async function updateAuth() {
        const { data: { session } } = await supabase.auth.getSession();
        
        if (session?.user) {
            const email = session.user.email || '';
            const displayEmail = email.length > 20 ? email.substring(0, 17) + '...' : email;
            
            // Ocultamos el botón general de "Zona Padres" porque lo pondremos en su caja personal
            const guestParentZone = document.getElementById('parent-zone-guest');
            if(guestParentZone) guestParentZone.style.display = 'none';
            
            authUi!.innerHTML = `
                <div class="user-menu-container">
                    <button id="user-menu-btn" class="user-text-btn">
                        Hola, <strong>${displayEmail}</strong>
                        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                    </button>
                    
                    <div id="user-dropdown" class="user-dropdown" style="display: none;">
                        <div class="dropdown-body">
                            <a href="/perfil" class="dropdown-item">Mi Perfil (Cambiar Datos)</a>
                            <a href="/parents" class="dropdown-item">Zona de Padres 🔒</a>
                        </div>
                        <div class="dropdown-footer">
                            <button id="logout-btn" class="dropdown-item btn-logout">Cerrar Sesión</button>
                        </div>
                    </div>
                </div>
            `;
            
            const menuBtn = document.getElementById('user-menu-btn');
            const dropdown = document.getElementById('user-dropdown');
            
            menuBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                if (dropdown?.style.display === 'none') {
                    dropdown.style.display = 'block';
                    menuBtn.classList.add('open');
                } else {
                    dropdown!.style.display = 'none';
                    menuBtn.classList.remove('open');
                }
            });

            document.addEventListener('click', (e) => {
                if (authUi && !authUi.contains(e.target as Node)) {
                    dropdown!.style.display = 'none';
                    menuBtn?.classList.remove('open');
                }
            });

            const logoutBtn = document.getElementById('logout-btn');
            logoutBtn?.addEventListener('click', async () => {
                await supabase.auth.signOut();
                window.location.href = '/';
            });
            
            // Sync progress on session detection
            SyncService.onLogin().catch(err => {
                console.error('[Header] Sync failed:', err);
            });
        }
        
        // Show the UI after processing
        const authLoading = document.getElementById('auth-loading');
        if (authLoading) authLoading.style.display = 'none';
        authUi!.style.display = 'block';
        // peq delay to allow DOM update before opacity transition
        setTimeout(() => {
            authUi!.style.opacity = '1';
        }, 10);
    }
    
    updateAuth();
    
    // Listen for auth changes
    supabase.auth.onAuthStateChange((event) => {
        if (event === 'SIGNED_IN') {
            updateAuth();
        } else if (event === 'SIGNED_OUT') {
            window.location.reload();
        }
    });
</script>

<style is:global>
  /* ===== MAIN HEADER ===== */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 2rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* ===== LOGO ===== */
  .logo a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-text {
    font-weight: 800;
    font-size: 1.8rem;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo-beta {
    font-size: 0.65rem;
    background: rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    margin-left: 0.5rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  /* ===== NAV ===== */
  .main-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-link:hover, .nav-link.active {
    color: #f8fafc;
  }
  
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #38bdf8;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
  }

  /* ===== RIGHT CLUSTER ===== */
  .right-cluster {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* ===== PARENT ZONE GUEST ===== */
  .parent-link {
    color: #94a3b8;
    font-size: 0.85rem;
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.03);
  }
  
  .parent-link:hover, .parent-link.active {
    background: rgba(255,255,255,0.1);
    color: #fff;
    border-color: rgba(255,255,255,0.2);
  }

  /* ===== LOGIN BTN GUEST ===== */
  .btn-login {
    font-size: 0.95rem;
    font-weight: 600;
    color: #0f172a;
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    text-decoration: none;
    padding: 0.45rem 1.2rem;
    border-radius: 99px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.25);
  }
  
  .btn-login:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(56, 189, 248, 0.4);
    filter: brightness(1.1);
  }

  /* ===== USER MENU (EBAY STYLE) ===== */
  .user-menu-container {
    position: relative;
  }
  
  .user-text-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    color: #f8fafc;
    font-size: 0.95rem;
    cursor: pointer;
    padding: 0.5rem;
    transition: color 0.2s ease;
    font-family: inherit;
  }
  
  .user-text-btn:hover, .user-text-btn.open {
    color: #38bdf8;
  }
  
  .user-text-btn strong {
    font-weight: 600;
  }
  
  .chevron {
    transition: transform 0.2s ease;
  }
  
  .user-text-btn.open .chevron {
    transform: rotate(180deg);
  }
  
  /* ===== USER DROPDOWN ===== */
  .user-dropdown {
    position: absolute;
    top: calc(100% + 5px);
    right: 0;
    width: 220px;
    background: rgba(15, 23, 42, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5);
    overflow: hidden;
    z-index: 200;
  }
  
  /* Open dropdown on hover for desktop */
  .user-menu-container:hover .user-dropdown {
    display: block !important;
  }
  
  .dropdown-body {
    padding: 0.5rem;
  }

  .dropdown-item {
    display: block;
    padding: 0.65rem 1rem;
    color: #cbd5e1;
    text-decoration: none;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  
  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #f8fafc;
  }
  
  .dropdown-footer {
    padding: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  
  .btn-logout {
    color: #fca5a5;
  }
  
  .btn-logout:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
  }

  /* ===== SKELETON LOADER ===== */
  .auth-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 38px;
  }
  
  .skeleton-btn {
    width: 80px;
    height: 34px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 99px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  @keyframes skeleton-pulse {
    0% { opacity: 0.5; }
    50% { opacity: 0.8; }
    100% { opacity: 0.5; }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .header { padding: 1rem 5%; }
    .main-nav { display: none; } /* Hide on mobile to save space */
    .parent-zone { display: none; }
  }
</style>
