---
import { loadScenarios, loadUnidadesAventura } from '../lib/scenario-loader';

// Catálogo unificado de insignias (doc 04 §3.5, "Insignias v2"): hay dos
// sistemas de contenido independientes que otorgan al MISMO array
// children.badges (ver unidad-engine.ts renderComparte) — el legacy
// (loadScenarios, tramos 10-11/12-14, 4 unidades) y el unidad-aventura
// (loadUnidadesAventura, tramo 8-9, 16 unidades). Antes de esto, BadgeGrid
// solo leía el legacy: los 3 badges reales del tramo 8-9 (cazaerrores-n1,
// guardian-secretos, creador-ia-8-9) se ganaban y persistían pero nunca
// aparecían en esta pantalla. Se fusionan aquí en un solo catálogo.
interface BadgeCatalogEntry {
    id: string;
    name: string;
    icon: string;
    description: string;
    nivel: number;
    tramo: string;
    origenLabel: string; // qué mostrar bajo el nombre ("Unidad 1.2" / "Zona Descubre")
    earnHint: string; // cómo conseguirla, para cuando está bloqueada
    // El reto legacy que la otorgaba ya está migrado a unidad-aventura y la
    // unidad nueva no da esta insignia (las por-reto del legacy no salen del
    // docx del método): ya no hay camino para ganarla. Solo se muestra a
    // quien YA la tenga (lo ganado no se quita) — el resto no debe ver una
    // insignia imposible.
    huerfana?: boolean;
}

const scenarios = await loadScenarios('es');
const unidades89 = await loadUnidadesAventura('8-9');
const unidades1011 = await loadUnidadesAventura('10-11');

const migradasPorTramo = new Map<string, Set<string>>([
    ['8-9', new Set(unidades89.map(u => u.id))],
    ['10-11', new Set(unidades1011.map(u => u.id))],
]);
const insigniasAventura = new Set(
    [...unidades89, ...unidades1011]
        .map(u => u.comparte.insigniaPosible?.id)
        .filter((id): id is string => Boolean(id))
);

const legacyEntries: BadgeCatalogEntry[] = scenarios
    .filter(s => s.tramo)
    .map(s => ({
        id: s.badge.id,
        name: s.badge.name,
        icon: s.badge.icon,
        description: s.badge.description,
        nivel: s.nivel ?? 1,
        tramo: s.tramo!,
        origenLabel: `Unidad ${s.unidad}`,
        earnHint: s.required_badge_id
            ? `Antes consigue la insignia "${scenarios.find(x => x.badge.id === s.required_badge_id)?.badge.name ?? ''}"`
            : `Completa el reto "${s.title.replace(/^\d+(\.\d+)?\s*/, '')}"`,
        huerfana: Boolean(
            s.unidad
            && migradasPorTramo.get(s.tramo!)?.has(s.unidad)
            && !insigniasAventura.has(s.badge.id)
        ),
    }));

// Las insignias del tramo 8-9 se otorgan al terminar la última unidad de
// cada zona (comparte.insigniaPosible) — no todas las zonas tienen una hoy
// (Zona Creación aún no, es un hueco de contenido real, no de código).
const unidadesPorZona = new Map<string, number>();
unidades89.forEach(u => unidadesPorZona.set(u.zona.nombre, (unidadesPorZona.get(u.zona.nombre) ?? 0) + 1));

const aventuraEntries89: BadgeCatalogEntry[] = unidades89
    .filter(u => u.comparte.insigniaPosible)
    .map(u => ({
        id: u.comparte.insigniaPosible!.id,
        name: u.comparte.insigniaPosible!.name,
        icon: u.comparte.insigniaPosible!.icon,
        description: u.comparte.insigniaPosible!.description,
        nivel: u.nivel,
        tramo: '8-9',
        origenLabel: u.zona.nombre,
        earnHint: `Completa las ${unidadesPorZona.get(u.zona.nombre) ?? 4} misiones de la ${u.zona.nombre}`,
    }));

// En 10-11 la insignia va ligada al reto concreto que la otorga (el docx del
// programa define 4, una por nivel — p. ej. Cazaerrores Nivel 2 en el 1.4).
const aventuraEntries1011: BadgeCatalogEntry[] = unidades1011
    .filter(u => u.comparte.insigniaPosible)
    .map(u => ({
        id: u.comparte.insigniaPosible!.id,
        name: u.comparte.insigniaPosible!.name,
        icon: u.comparte.insigniaPosible!.icon,
        description: u.comparte.insigniaPosible!.description,
        nivel: u.nivel,
        tramo: '10-11',
        origenLabel: `Misión ${u.id}`,
        earnHint: `Completa la misión "${u.titulo}"`,
    }));

// Dedupe por id de insignia: cuando un reto legacy ya está migrado a
// unidad-aventura, su insignia aparece en ambos catálogos (mismo id, p. ej.
// cazaerrores-2) — gana la entrada de la unidad migrada, que es la vigente.
const badgeCatalogMap = new Map<string, BadgeCatalogEntry>();
[...legacyEntries, ...aventuraEntries89, ...aventuraEntries1011].forEach(b => badgeCatalogMap.set(b.id, b));
const badgeCatalog = [...badgeCatalogMap.values()];
const niveles = [...new Set(badgeCatalog.map(b => b.nivel))].sort((a, b) => a - b);
---

<div class="badges-interface">
    <div class="filters">
        <button class="filter-btn active" data-cat="all">Todos</button>
        {niveles.map(n => (
            <button class="filter-btn" data-cat={`nivel-${n}`}>Nivel {n}</button>
        ))}
    </div>

    <div class="badges-grid">
        {badgeCatalog.map(b => (
            <div class="badge-card" data-cat={`nivel-${b.nivel}`} data-id={b.id} data-tramo={b.tramo} data-huerfana={b.huerfana ? 'true' : undefined}>
                <div class="hologram-effect"></div>
                <div class="lock-badge" aria-hidden="true">🔒</div>
                <div class="badge-icon">{b.icon}</div>
                <div class="badge-info">
                    <h4>{b.name}</h4>
                    <span class="badge-cat">{b.origenLabel}</span>
                    <p class="badge-desc badge-desc--earned">{b.description}</p>
                    <p class="badge-desc badge-desc--hint">{b.earnHint}</p>
                </div>
            </div>
        ))}
    </div>

    <p id="no-badges-tramo" class="no-badges-tramo hidden">Todavía no hay insignias disponibles para el tramo de edad de este hijo/a.</p>
</div>

<script>
    import { ProgressService } from '../lib/progress-service';
    import { ChildrenService } from '../lib/children-service';
    import { activeChild } from '../lib/active-child';
    import { tramoForChild } from '../lib/tramos';

    const cards = Array.from(document.querySelectorAll('.badge-card'));
    const noBadgesMsg = document.getElementById('no-badges-tramo');

    // Un hijo/a solo puede ganar las insignias de su propio tramo de edad;
    // mostrar las de los otros tramos sería engañoso (nunca las conseguirá).
    async function filterByTramo() {
        const childId = activeChild.get();
        if (!childId) return;

        const children = await ChildrenService.listChildren();
        const child = children.find(c => c.id === childId);
        const tramo = child ? tramoForChild(child.birth_date) : null;
        const myTramo = tramo ? tramo.id : null;

        let visibleCount = 0;
        cards.forEach(card => {
            const delTramo = !myTramo || card.getAttribute('data-tramo') === myTramo;
            // Huérfana (su reto legacy migró y la unidad nueva no la da): solo
            // se enseña a quien ya la ganó — requiere que initBadges() haya
            // marcado .earned ANTES de este filtro (ver init()).
            const huerfanaNoGanada = (card as HTMLElement).dataset.huerfana === 'true'
                && !card.classList.contains('earned');
            const matches = delTramo && !huerfanaNoGanada;
            card.classList.toggle('wrong-tramo', !matches);
            if (matches) visibleCount++;
        });

        if (noBadgesMsg) noBadgesMsg.classList.toggle('hidden', visibleCount > 0);

        // Informa a la página (p. ej. insignias.astro) de cuántas insignias
        // puede llegar a ganar este hijo/a en su tramo, para calcular rangos.
        window.dispatchEvent(new CustomEvent('badges:tramo-ready', { detail: { total: visibleCount } }));
    }

    // 1. Mark earned badges - logic wrapped to ensure DOM is ready
    function initBadges() {
        const state = ProgressService.getState();
        const userBadges = state.badges || [];

        cards.forEach(card => {
            const id = card.getAttribute('data-id') || '';
            card.classList.toggle('earned', userBadges.includes(id));
        });
    }

    async function init() {
        initBadges(); // primero: filterByTramo necesita saber qué está ganado
        await filterByTramo();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    document.addEventListener('astro:page-load', init);
    window.addEventListener('progress:updated', initBadges);
    window.addEventListener('active-child:changed', init);

    // 2. Filter Logic (por nivel, sin afectar el filtro de tramo)
    const filters = document.querySelectorAll('.filter-btn');

    filters.forEach(btn => {
        btn.addEventListener('click', () => {
            filters.forEach(f => f.classList.remove('active'));
            btn.classList.add('active');

            const cat = btn.getAttribute('data-cat');

            cards.forEach(card => {
                const cardCat = card.getAttribute('data-cat');
                card.classList.toggle('hidden-filter', !(cat === 'all' || cardCat === cat));
            });
        });
    });
</script>

<style>
    .badges-interface {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .filters {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: center;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .filter-btn {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.2);
        color: #888;
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
    }

    .filter-btn:hover {
        border-color: var(--color-primary);
        color: white;
    }

    .filter-btn.active {
        background: var(--color-primary);
        color: black;
        border-color: var(--color-primary);
        font-weight: bold;
    }

    .badges-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 1.5rem;
    }

    .badge-card {
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s;
        min-height: 200px;
    }

    .badge-card.hidden-filter,
    .badge-card.wrong-tramo {
        display: none;
    }

    .no-badges-tramo {
        text-align: center;
        color: #a1a1aa;
    }

    .no-badges-tramo.hidden {
        display: none;
    }

    /* Locked State — insignias v2 (doc 04 §3.5): en vez de tapar la
       tarjeta entera con un "❓", se ve el icono apagado y el texto de
       "cómo conseguirla" en vez de la descripción, para que sea una guía
       y no solo un misterio. */
    .badge-card:not(.earned) .badge-icon {
        filter: grayscale(1) opacity(0.5);
    }

    .lock-badge {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        font-size: 0.9rem;
        opacity: 0.5;
        z-index: 3;
    }

    .badge-card.earned .lock-badge {
        display: none;
    }

    .badge-desc--earned {
        display: none;
    }

    .badge-card.earned .badge-desc--earned {
        display: block;
    }

    .badge-desc--hint {
        font-style: italic;
    }

    .badge-card.earned .badge-desc--hint {
        display: none;
    }

    /* Earned State */
    .badge-card.earned {
        border-color: var(--color-primary);
        box-shadow: 0 0 15px rgba(34, 211, 238, 0.2);
        background: rgba(34, 211, 238, 0.05);
    }

    /* Hologram Effect */
    .hologram-effect {
        /* Placeholder for scanlines/glow */
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            to bottom,
            transparent 50%,
            rgba(34, 211, 238, 0.05) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 1;
        opacity: 0.5;
    }

    .badge-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        z-index: 2;
        filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.5));
    }

    .badge-info {
        z-index: 2;
    }

    .badge-info h4 {
        margin: 0;
        font-size: 1rem;
        color: white;
    }

    .badge-cat {
        font-size: 0.7rem;
        color: var(--color-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
        display: block;
    }

    .badge-desc {
        font-size: 0.8rem;
        color: #a1a1aa;
        margin: 0;
        line-height: 1.4;
    }
</style>
