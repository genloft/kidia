---
import { loadScenarios } from '../lib/scenario-loader';

// Las insignias reales vienen del contenido (una por unidad×tramo, ver
// src/content/es/*.json), no de un catálogo aparte — así nunca hay
// insignias que el niño pueda ganar pero que aquí no aparezcan (o viceversa).
const scenarios = await loadScenarios('es');
const niveles = [...new Set(scenarios.map(s => s.nivel).filter(Boolean))].sort();
---

<div class="badges-interface">
    <div class="filters">
        <button class="filter-btn active" data-cat="all">Todos</button>
        {niveles.map(n => (
            <button class="filter-btn" data-cat={`nivel-${n}`}>Nivel {n}</button>
        ))}
    </div>

    <div class="badges-grid">
        {scenarios.map(s => (
            <div class="badge-card" data-cat={`nivel-${s.nivel}`} data-id={s.badge.id} data-tramo={s.tramo}>
                <div class="hologram-effect"></div>
                <div class="badge-icon">{s.badge.icon}</div>
                <div class="badge-info">
                    <h4>{s.badge.name}</h4>
                    <span class="badge-cat">Unidad {s.unidad}</span>
                    <p class="badge-desc">{s.badge.description}</p>
                </div>
                <div class="lock-overlay">
                    <span>❓</span>
                </div>
            </div>
        ))}
    </div>

    <p id="no-badges-tramo" class="no-badges-tramo hidden">Todavía no hay insignias disponibles para el tramo de edad de este hijo/a.</p>
</div>

<script>
    import { ProgressService } from '../lib/progress-service';
    import { ChildrenService } from '../lib/children-service';
    import { activeChild } from '../lib/active-child';
    import { tramoForChild } from '../lib/tramos';

    const cards = Array.from(document.querySelectorAll('.badge-card'));
    const noBadgesMsg = document.getElementById('no-badges-tramo');

    // Un hijo/a solo puede ganar las insignias de su propio tramo de edad;
    // mostrar las de los otros tramos sería engañoso (nunca las conseguirá).
    async function filterByTramo() {
        const childId = activeChild.get();
        if (!childId) return;

        const children = await ChildrenService.listChildren();
        const child = children.find(c => c.id === childId);
        const tramo = child ? tramoForChild(child.birth_date) : null;
        const myTramo = tramo ? tramo.id : null;

        let visibleCount = 0;
        cards.forEach(card => {
            const matches = !myTramo || card.getAttribute('data-tramo') === myTramo;
            card.classList.toggle('wrong-tramo', !matches);
            if (matches) visibleCount++;
        });

        if (noBadgesMsg) noBadgesMsg.classList.toggle('hidden', visibleCount > 0);

        // Informa a la página (p. ej. insignias.astro) de cuántas insignias
        // puede llegar a ganar este hijo/a en su tramo, para calcular rangos.
        window.dispatchEvent(new CustomEvent('badges:tramo-ready', { detail: { total: visibleCount } }));
    }

    // 1. Mark earned badges - logic wrapped to ensure DOM is ready
    function initBadges() {
        const state = ProgressService.getState();
        const userBadges = state.badges || [];

        cards.forEach(card => {
            const id = card.getAttribute('data-id');
            card.classList.toggle('earned', userBadges.includes(id));
        });
    }

    async function init() {
        await filterByTramo();
        initBadges();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    document.addEventListener('astro:page-load', init);
    window.addEventListener('progress:updated', initBadges);
    window.addEventListener('active-child:changed', init);

    // 2. Filter Logic (por nivel, sin afectar el filtro de tramo)
    const filters = document.querySelectorAll('.filter-btn');

    filters.forEach(btn => {
        btn.addEventListener('click', () => {
            filters.forEach(f => f.classList.remove('active'));
            btn.classList.add('active');

            const cat = btn.getAttribute('data-cat');

            cards.forEach(card => {
                const cardCat = card.getAttribute('data-cat');
                card.classList.toggle('hidden-filter', !(cat === 'all' || cardCat === cat));
            });
        });
    });
</script>

<style>
    .badges-interface {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .filters {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: center;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .filter-btn {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.2);
        color: #888;
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.9rem;
    }

    .filter-btn:hover {
        border-color: var(--color-primary);
        color: white;
    }

    .filter-btn.active {
        background: var(--color-primary);
        color: black;
        border-color: var(--color-primary);
        font-weight: bold;
    }

    .badges-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 1.5rem;
    }

    .badge-card {
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s;
        min-height: 200px;
    }

    .badge-card.hidden-filter,
    .badge-card.wrong-tramo {
        display: none;
    }

    .no-badges-tramo {
        text-align: center;
        color: #a1a1aa;
    }

    .no-badges-tramo.hidden {
        display: none;
    }

    /* Locked State */
    .lock-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        z-index: 10;
        backdrop-filter: blur(1px);
        color: rgba(255,255,255,0.3);
    }

    /* Earned State */
    .badge-card.earned .lock-overlay {
        display: none;
    }

    .badge-card.earned {
        border-color: var(--color-primary);
        box-shadow: 0 0 15px rgba(34, 211, 238, 0.2);
        background: rgba(34, 211, 238, 0.05);
    }

    /* Hologram Effect */
    .hologram-effect {
        /* Placeholder for scanlines/glow */
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            to bottom,
            transparent 50%,
            rgba(34, 211, 238, 0.05) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 1;
        opacity: 0.5;
    }

    .badge-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        z-index: 2;
        filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.5));
    }

    .badge-info {
        z-index: 2;
    }

    .badge-info h4 {
        margin: 0;
        font-size: 1rem;
        color: white;
    }

    .badge-cat {
        font-size: 0.7rem;
        color: var(--color-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
        display: block;
    }

    .badge-desc {
        font-size: 0.8rem;
        color: #a1a1aa;
        margin: 0;
        line-height: 1.4;
    }
</style>
