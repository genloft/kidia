---
interface Props {
  scenario: any; // Using any for now to avoid extensive import cycles, or import Schema
}

const { scenario } = Astro.props;
---

<div id="chat-root" class="chat-container" data-scenario={JSON.stringify(scenario)}>
    <div class="chat-header">
        <div class="chat-header-avatar"></div>
        <div class="chat-header-info">
            <span class="chat-header-name">Dra. Vael</span>
            <span class="chat-header-tag">IA mediada · puede equivocarse</span>
        </div>
    </div>
    <div class="step-indicator" id="step-indicator">
        <div class="step-item" data-step="chispa"><span class="step-dot"></span><span class="step-label">Chispa</span></div>
        <div class="step-item" data-step="explora"><span class="step-dot"></span><span class="step-label">Explora</span></div>
        <div class="step-item" data-step="crea"><span class="step-dot"></span><span class="step-label">Crea</span></div>
        <div class="step-item" data-step="reflexiona"><span class="step-dot"></span><span class="step-label">Reflexiona</span></div>
        <div class="step-item" data-step="comparte"><span class="step-dot"></span><span class="step-label">Comparte</span></div>
    </div>
    <div class="messages-list"></div>
    <div class="options-area hidden"></div>
    <div class="continue-area hidden"></div>
</div>

<script define:vars={{ scenario }}>
    // Pass for view transitions if needed, but we use the JSON below for the class
</script>

<!-- Embedded Data for Client Rehydration -->
<script is:inline id="scenario-data" type="application/json">
    // Populated by server-side replacement or we can just use define:vars above?
    // Actually, for a class outside of .astro scope, passing via window or JSON is better.
    // Let's use the define:vars to assign to window for simplicity in this MVP.
</script>

<script>
    import { GameEngine } from '../lib/game-engine';

    // Indicador de pasos: GameEngine emite el momento (Chispa/Explora/Crea/
    // Reflexiona/Comparte) al renderizar cada nodo de diálogo. Este listener
    // debe registrarse ANTES de arrancar GameEngine (más abajo), porque su
    // primer nodo se renderiza de forma síncrona en el constructor y ya
    // dispara el evento del primer paso.
    const STEP_ORDER = ['chispa', 'explora', 'crea', 'reflexiona', 'comparte'];
    window.addEventListener('kidia:step', (e) => {
        const step = e.detail?.step;
        if (!step) return;
        const idx = STEP_ORDER.indexOf(step);
        document.querySelectorAll('#step-indicator .step-item').forEach(item => {
            const itemIdx = STEP_ORDER.indexOf(item.getAttribute('data-step'));
            item.classList.toggle('active', itemIdx === idx);
            item.classList.toggle('done', itemIdx < idx);
        });
    });

    // Wait for DOM
    document.addEventListener('astro:page-load', () => {
        initGame();
    });

    // Also run on immediate load (if no ViewTransitions or first load)
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initGame();
    } else {
        document.addEventListener('DOMContentLoaded', initGame);
    }

    function initGame() {
        const root = document.getElementById('chat-root');
        if (!root) return;
        if (root.getAttribute('data-loaded')) return; // Prevent double init

        // Get data from data-attribute (cleanest)
        const dataRaw = root.getAttribute('data-scenario');
        if (!dataRaw) return;

        const scenario = JSON.parse(dataRaw);
        new GameEngine(scenario, 'chat-root');
        root.setAttribute('data-loaded', 'true');
    }
</script>



<style is:global>
    :root {
        --chat-bg: var(--color-bg, #09090b);
        --incoming-bg: var(--color-surface, #18181b);
        --outgoing-bg: linear-gradient(135deg, var(--color-primary, #22d3ee), var(--color-accent, #8b5cf6));
        --text-primary: var(--color-text, #e4e4e7);
        --text-secondary: #94a3b8;
        --accent: var(--color-primary, #22d3ee);
    }

    .chat-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        background:
            radial-gradient(circle at 15% 0%, rgba(34, 211, 238, 0.08), transparent 45%),
            radial-gradient(circle at 85% 100%, rgba(139, 92, 246, 0.08), transparent 45%),
            var(--chat-bg);
        position: relative;
        overflow: hidden;
        font-family: var(--font-body, 'Outfit', sans-serif);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1.25rem;
    }

    .chat-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        position: relative;
        z-index: 1;
        flex-shrink: 0;
    }

    .chat-header-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-image: url('/kidia_explaining.webp');
        background-size: 300%;
        background-position: 50% 8%;
        background-repeat: no-repeat;
        background-color: var(--incoming-bg);
        border: 1px solid rgba(34, 211, 238, 0.4);
        flex-shrink: 0;
    }

    .chat-header-info {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    .chat-header-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--text-primary);
    }

    .chat-header-tag {
        font-size: 0.7rem;
        color: var(--text-secondary);
    }

    .step-indicator {
        display: flex;
        justify-content: space-between;
        gap: 0.25rem;
        padding: 0.7rem 1.1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        overflow-x: auto;
    }

    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        flex: 1;
        min-width: 0;
    }

    .step-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
    }

    .step-label {
        font-size: 0.62rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .step-item.done .step-dot {
        background: var(--color-primary, #22d3ee);
    }

    .step-item.active .step-dot {
        background: var(--color-primary, #22d3ee);
        box-shadow: 0 0 8px var(--color-primary, #22d3ee);
        transform: scale(1.3);
    }

    .step-item.active .step-label {
        color: var(--color-primary, #22d3ee);
        font-weight: 700;
    }

    .messages-list {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 5%;
        display: flex;
        flex-direction: column;
        gap: 0.5rem; /* Tighter grouping */
        position: relative;
        z-index: 1;
    }
    
    .message {
        display: flex;
        width: 100%;
        margin-bottom: 2px;
        position: relative;
        animation: slideIn 0.2s cubic-bezier(0.2, 0, 0.2, 1);
    }
    
    @keyframes slideIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .message.kidia,
    .message.morti {
        justify-content: flex-start;
        padding-right: 20%;
    }

    .message.user {
        justify-content: flex-end; 
        padding-left: 20%;
    }
    
    .message.system { 
        justify-content: center; 
        margin: 1rem 0;
    }
    
    /* Avatar Styles */
    .message.kidia::before,
    .message.morti::before {
        content: '';
        width: 35px;
        height: 35px;
        background-image: url('/kidia_explaining.webp');
        background-size: 300%; /* Zoom in to face */
        background-position: 50% 8%; /* Center top where face usually is */
        background-repeat: no-repeat;
        border-radius: 50%;
        margin-right: 10px;
        align-self: flex-start;
        margin-top: 5px;
        border: 1px solid rgba(255,255,255,0.15);
        flex-shrink: 0;
        background-color: var(--incoming-bg);
    }

    .message.morti::before {
        background-image: url('/morti.webp');
        background-size: 180%;
        background-position: 50% 20%;
    }
    
    .bubble {
        padding: 8px 14px 10px 14px; /* Adjusted padding for name */
        border-radius: 16px;
        font-size: 0.95rem;
        line-height: 1.4;
        position: relative;
        color: var(--text-primary);
        box-shadow: 0 2px 8px rgba(0,0,0,0.18);
        max-width: 100%;
        word-wrap: break-word;
        min-width: 120px; /* Ensure space for name */
    }

    /* Sender Name Styling */
    .sender-name {
        font-size: 0.75rem;
        font-weight: bold;
        margin-bottom: 2px;
        line-height: 1.2;
    }

    /* Kidia Bubble (Incoming) */
    .kidia .bubble,
    .morti .bubble {
        background: var(--incoming-bg);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom-left-radius: 4px;
    }

    .kidia .sender-name {
        color: var(--color-primary, #22d3ee);
    }

    .morti .sender-name {
        color: #7c9eff; /* Azul/violeta, coherente con la estética de Morti */
    }

    /* User Bubble (Outgoing) */
    .user .bubble {
        background: var(--outgoing-bg);
        color: #09090b;
        border-bottom-right-radius: 4px;
    }

    .user .sender-name {
        color: rgba(9, 9, 11, 0.6); /* Sobre el gradiente claro, texto oscuro */
        text-align: right;
    }
    
    /* System Messages */
    .system-bubble {
        background: rgba(34, 211, 238, 0.1);
        border: 1px solid rgba(34, 211, 238, 0.25);
        color: var(--color-primary, #22d3ee);
        font-size: 0.75rem;
        padding: 5px 12px;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    
    /* Input/Options Area */
    .options-area, .continue-area {
        background: var(--incoming-bg);
        padding: 10px 16px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        min-height: 60px;
        border-top: 1px solid rgba(255,255,255,0.05);
        position: relative;
        z-index: 2;
    }
    
    .options-area {
        justify-content: flex-start; /* Align response bubbles like suggestion chips */
        overflow-x: auto;
    }
    
    .continue-area {
        justify-content: center;
    }
    
    /* Response Buttons - Chip/Pill Style */
    .btn-option {
        background: rgba(255, 255, 255, 0.06);
        color: var(--text-primary);
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 8px 20px;
        border-radius: 24px; /* Full Pill */
        cursor: pointer;
        font-size: 0.9rem;
        transition: background 0.2s, transform 0.1s;
        text-align: center;
        flex-grow: 1;
        max-width: 100%;
        box-shadow: 0 1px 2px rgba(0,0,0,0.2);
    }

    .btn-option:hover {
        background: rgba(34, 211, 238, 0.15);
        border-color: rgba(34, 211, 238, 0.4);
    }

    .btn-option:active {
        background: rgba(255, 255, 255, 0.03);
        transform: scale(0.98);
    }

    .btn-continue {
        background: linear-gradient(135deg, var(--color-primary, #22d3ee), var(--color-accent, #8b5cf6));
        color: #09090b;
        border: none;
        padding: 10px 30px;
        border-radius: 24px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 2px 12px rgba(34, 211, 238, 0.25);
    }

    .btn-continue:hover {
        filter: brightness(1.1);
    }

    .hidden { display: none !important; }

    /* Actividades del paso "Crea" (clasificar / comparar / escribir / eleccion) */
    .options-area:has(.activity-wrap) {
        flex-direction: column;
        align-items: stretch;
        overflow-x: visible;
        min-height: 0;
        padding: 14px 16px;
    }

    .activity-wrap {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
    }

    .activity-instruction {
        margin: 0 0 4px 0;
        color: var(--text-secondary);
        font-size: 0.85rem;
    }

    .activity-body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .activity-body.activity-comparar,
    .activity-body.activity-eleccion {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .activity-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 8px 12px;
    }

    .activity-item-label {
        font-size: 0.9rem;
    }

    .activity-item-btns {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .activity-item-btns .btn-option {
        flex-grow: 0;
        padding: 6px 14px;
        font-size: 0.8rem;
    }

    .activity-item.activity-item-done.activity-correct {
        outline: 2px solid var(--accent);
    }

    .activity-item.activity-item-done:not(.activity-correct) {
        outline: 2px solid #f87171;
    }

    .activity-compare-card,
    .activity-choice {
        flex: 1 1 200px;
        text-align: left;
        line-height: 1.4;
    }

    .activity-compare-card.selected,
    .activity-choice.selected {
        outline: 2px solid var(--accent);
        background: rgba(34, 211, 238, 0.12);
    }

    .activity-textarea {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        color: var(--text-primary);
        padding: 10px 14px;
        font-family: inherit;
        font-size: 0.9rem;
        resize: vertical;
    }

    .activity-done {
        align-self: center;
        margin-top: 4px;
    }

    .activity-done:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; }
</style>
