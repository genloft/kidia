---
interface Props {
  scenario: any;
}

const { scenario } = Astro.props;
---

<div id="quiz-container" class="quiz-container hidden" data-scenario={JSON.stringify(scenario)}>
  <div class="quiz-content">
      <div class="quiz-header">
          <h2 class="quiz-title">🧠 Test de Conocimiento</h2>
          <span id="q-counter" class="quiz-counter"></span>
      </div>

      <!-- Intro State -->
      <div id="quiz-intro">
          <p>¡Has terminado el reto! Ahora demuestra lo que sabes.</p>
          <button id="btn-start" class="btn-primary">Empezar Quiz</button>
          <div class="secondary-actions">
              <button id="btn-restart" class="btn-secondary">Reiniciar Reto</button>
              <button id="btn-close" class="btn-secondary">Hacer más tarde</button>
          </div>
      </div>

      <!-- Question State -->
      <div id="quiz-play" class="hidden">
          <div id="quiz-question" class="question-text"></div>
          <div id="quiz-options" class="options-grid"></div>
          <div id="quiz-feedback" class="feedback hidden"></div>
          <button id="quiz-next" class="btn-primary hidden">Siguiente</button>
      </div>

      <!-- Results State -->
      <div id="quiz-results" class="hidden">
          <div class="score-ring">
              <span id="final-score">0</span><span class="score-percent">%</span>
          </div>
          <p id="kidia-reaction" class="reaction-text"></p>

          <div id="badge-notification" class="hidden">
              <div class="badge-icon-animate" id="badge-icon">🏆</div>
              <p class="badge-earned-label">¡Insignia conseguida!</p>
              <p class="badge-earned-name" id="badge-name"></p>
              <p class="badge-earned-desc" id="badge-desc"></p>
          </div>

          <button id="btn-finish" class="btn-primary">Volver al Mapa</button>
      </div>
  </div>
</div>

<script>
    import { storage, syncWithCloud } from '../lib/storage-simple';

    // Elements
    const container = document.getElementById('quiz-container');
    const introEl = document.getElementById('quiz-intro');
    const playEl = document.getElementById('quiz-play');
    const resultsEl = document.getElementById('quiz-results');
    
    // Parse scenario from data attribute
    let scenario;
    try {
        scenario = JSON.parse(container.dataset.scenario);
    } catch (e) {
        console.error('[Quiz] Failed to parse scenario data', e);
    }
    
    // Play Elements
    const qCounter = document.getElementById('q-counter');
    const questionEl = document.getElementById('quiz-question');
    const optionsEl = document.getElementById('quiz-options');
    const feedbackEl = document.getElementById('quiz-feedback');
    const nextBtn = document.getElementById('quiz-next');
    
    // Result Elements
    const finalScoreEl = document.getElementById('final-score');
    const reactionEl = document.getElementById('kidia-reaction');
    
    const questions = scenario?.quiz?.questions || [];
    
    let currentIdx = 0;
    let correctCount = 0;

    // Listeners
    window.addEventListener('startQuiz', (e) => {
        // console.log('[Quiz] Event received for:', e.detail.scenarioId);
        if (scenario && e.detail.scenarioId === scenario.id) {
            container.classList.remove('hidden');
            showIntro();
        }
    });

    document.getElementById('btn-start').onclick = startQuiz;
    
    // Close / Do Later button
    const closeBtn = document.getElementById('btn-close');
    if (closeBtn) {
        closeBtn.onclick = () => {
            container.classList.add('hidden');
        };
    }

    // Restart Button Logic (a través de storage-simple.ts para que quede
    // por hijo activo, no en una clave global compartida por todos).
    // storage.update() sincroniza con Supabase sin esperar (fire-and-forget),
    // así que si recargamos justo después esa escritura puede perderse: la
    // esperamos explícitamente antes de recargar la página.
    const restartBtn = document.getElementById('btn-restart');
    if (restartBtn) {
        restartBtn.onclick = async () => {
            try {
                storage.update(s => {
                    const scenarioProgress = { ...(s.scenarioProgress || {}) };
                    delete scenarioProgress[scenario.id];
                    return { ...s, scenarioProgress };
                });
                await syncWithCloud();
            } catch (e) {
                console.error('Error clearing progress', e);
            }
            window.location.reload();
        };
    }

    document.getElementById('btn-finish').onclick = async () => {
        // Igual que el reinicio: asegura que la puntuación/insignia de
        // finishQuiz() ya han llegado a Supabase antes de salir de la página.
        try {
            await syncWithCloud();
        } catch (e) {
            console.error('[Quiz] Sync before navigating away failed', e);
        }
        window.location.href = '/mapa';
    };
    if(nextBtn) nextBtn.onclick = nextQuestion;

    function showIntro() {
        introEl.classList.remove('hidden');
        playEl.classList.add('hidden');
        resultsEl.classList.add('hidden');
    }

    function startQuiz() {
        currentIdx = 0;
        correctCount = 0;
        introEl.classList.add('hidden');
        playEl.classList.remove('hidden');
        renderQuestion();
    }

    const OPTION_LETTERS = ['A', 'B', 'C', 'D'];

    function renderQuestion() {
        const q = questions[currentIdx];
        if(!q) return finishQuiz();

        qCounter.innerText = `Pregunta ${currentIdx + 1} de ${questions.length}`;
        questionEl.textContent = q.text;
        optionsEl.innerHTML = '';
        feedbackEl.className = 'feedback hidden';
        nextBtn.classList.add('hidden');

        q.options.forEach((text, index) => {
            const btn = document.createElement('button');
            btn.className = 'quiz-option';
            btn.innerHTML = `
                <span class="quiz-option-letter">${OPTION_LETTERS[index] || index + 1}</span>
                <span class="quiz-option-text"></span>
                <span class="quiz-option-icon"></span>
            `;
            btn.querySelector('.quiz-option-text').textContent = text;
            btn.onclick = () => checkAnswer(index, btn, q);
            optionsEl.appendChild(btn);
        });
    }

    function checkAnswer(index, btn, question) {
        optionsEl.querySelectorAll('button').forEach(b => b.disabled = true);

        const isCorrect = index === question.correct_index;
        const icon = btn.querySelector('.quiz-option-icon');

        if (isCorrect) {
            btn.classList.add('correct');
            if (icon) icon.textContent = '✓';
            feedbackEl.textContent = `✅ ¡Correcto! ${question.explanation}`;
            feedbackEl.classList.add('correct');
            correctCount++;
        } else {
            btn.classList.add('wrong');
            if (icon) icon.textContent = '✗';
            feedbackEl.textContent = `❌ ${question.explanation}`;
            feedbackEl.classList.add('wrong');

            const correctBtn = optionsEl.children[question.correct_index];
            if (correctBtn) {
                correctBtn.classList.add('correct');
                const correctIcon = correctBtn.querySelector('.quiz-option-icon');
                if (correctIcon) correctIcon.textContent = '✓';
            }
        }

        feedbackEl.classList.remove('hidden');
        nextBtn.classList.remove('hidden');
    }
    
    function nextQuestion() {
        currentIdx++;
        if (currentIdx < questions.length) {
            renderQuestion();
        } else {
            finishQuiz();
        }
    }

    function finishQuiz() {
        playEl.classList.add('hidden');
        resultsEl.classList.remove('hidden');
        qCounter.innerText = '';
        
        const score = Math.round((correctCount / questions.length) * 100);
        
        finalScoreEl.innerText = score.toString();
        
        // Kidia Reaction
        let reaction = "";
        if (score === 100) reaction = "¡Increíble! 🌟 ¡Eres un gurú de la IA!";
        else if (score >= 70) reaction = "¡Muy bien! 🧠 Ya casi lo dominas todo.";
        else reaction = "¡Buen intento! 💪 Repasa un poco y vuelve a intentarlo.";
        
        reactionEl.innerText = reaction;

        // Save Logic (a través de storage-simple.ts para que quede por hijo activo, no global)
        try {
            const badgeNotif = document.getElementById('badge-notification');
            const badgeIconEl = document.getElementById('badge-icon');
            const badgeNameEl = document.getElementById('badge-name');
            const badgeDescEl = document.getElementById('badge-desc');
            const earnedBadge = score >= 70 && scenario.badge;

            storage.update(s => ({
                ...s,
                completedScenarios: [...new Set([...(s.completedScenarios || []), scenario.id])],
                scores: { ...(s.scores || {}), [scenario.id]: score },
                badges: earnedBadge
                    ? [...new Set([...(s.badges || []), scenario.badge.id])]
                    : (s.badges || [])
            }));

            if (earnedBadge) {
                badgeIconEl.innerText = scenario.badge.icon || '🏆';
                badgeNameEl.innerText = scenario.badge.name;
                badgeDescEl.innerText = scenario.badge.description || '';
                badgeNotif.classList.remove('hidden');
                badgeNotif.classList.add('animate-pop');
            }
        } catch(e) {
            console.error('[Quiz] Save error', e);
        }
    }
</script>

<style>
    .quiz-container {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        opacity: 1;
        transition: opacity 0.4s ease;
    }

    .quiz-container.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .quiz-content {
        background: rgba(24, 24, 27, 0.97);
        border: 1px solid rgba(34, 211, 238, 0.3);
        box-shadow: 0 20px 70px rgba(0, 0, 0, 0.5), 0 0 60px rgba(34, 211, 238, 0.15);
        padding: 2.75rem;
        border-radius: 1.75rem;
        max-width: 640px;
        width: 90%;
        max-height: 85vh;
        overflow-y: auto;
        text-align: center;
        position: relative;
    }

    /* Decorative Gradient Blob */
    .quiz-content::before {
        content: '';
        position: absolute;
        top: -50px;
        left: 50%;
        transform: translateX(-50%);
        width: 240px;
        height: 120px;
        background: var(--color-primary);
        filter: blur(90px);
        opacity: 0.18;
        pointer-events: none;
        z-index: 0;
    }

    .quiz-content > * {
        position: relative;
        z-index: 1;
    }

    .quiz-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }

    .quiz-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.9rem;
        margin: 0;
        background: linear-gradient(135deg, #fff, #a5f3fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .quiz-counter {
        display: inline-block;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        font-size: 0.85rem;
        padding: 0.3rem 0.9rem;
        border-radius: 99px;
        min-height: 1.2em;
    }

    .question-text {
        font-size: 1.4rem;
        font-weight: 600;
        line-height: 1.55;
        margin-bottom: 1.75rem;
        color: #f4f4f5;
    }
    
    /* Modern Button Base */
    .btn-primary, .btn-secondary {
        font-family: 'Outfit', sans-serif;
        padding: 1rem 2rem;
        border-radius: 9999px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: none;
        display: inline-block;
        margin-top: 1rem;
    }
    
    .btn-primary {
        background: var(--color-primary);
        color: #09090b;
        box-shadow: 0 0 20px rgba(34, 211, 238, 0.4);
        animation: quiz-btn-heartbeat 1.7s ease-in-out infinite;
    }

    @keyframes quiz-btn-heartbeat {
        0%, 100% { transform: scale(1); box-shadow: 0 0 20px rgba(34, 211, 238, 0.4); }
        50% { transform: scale(1.035); box-shadow: 0 0 34px rgba(34, 211, 238, 0.7); }
    }

    .btn-primary:hover {
        animation-play-state: paused;
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 0 30px rgba(34, 211, 238, 0.6);
    }

    .btn-secondary {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.8);
        margin-left: 1rem;
    }
    
    .btn-secondary:hover {
        border-color: #fff;
        background: rgba(255,255,255,0.05);
        color: #fff;
    }

    .secondary-actions {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }
    
    .secondary-actions .btn-secondary {
        margin: 0; /* Override default margin */
        font-size: 0.9rem;
        padding: 0.6rem 1.2rem;
    }

    .options-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 2rem 0;
    }

    .quiz-option {
        width: 100%;
        padding: 1rem 1.25rem;

        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);

        color: #e2e8f0;
        border-radius: 1.1rem; /* Softer rounded corners */
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        text-align: left; /* Better for reading answers */
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
        position: relative;
        display: flex; /* Allow icon alignment if needed */
        align-items: center;
        gap: 1rem;
    }

    .quiz-option-letter {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.95rem;
        background: rgba(255, 255, 255, 0.08);
        color: var(--color-primary);
        transition: all 0.25s ease;
    }

    .quiz-option-text {
        flex: 1;
        line-height: 1.4;
    }

    .quiz-option-icon {
        flex-shrink: 0;
        width: 22px;
        text-align: center;
        font-weight: 800;
        font-size: 1.15rem;
    }

    /* Hover Effect */
    .quiz-option:hover:not(:disabled) {
        background: rgba(34, 211, 238, 0.07);
        transform: translateY(-3px);
        border-color: rgba(34, 211, 238, 0.5);
        box-shadow: 0 8px 24px rgba(34, 211, 238, 0.15);
    }

    .quiz-option:hover:not(:disabled) .quiz-option-letter {
        background: var(--color-primary);
        color: #09090b;
    }

    /* Selected/Correct State */
    .quiz-option.correct {
        background: rgba(16, 185, 129, 0.15) !important;
        border-color: #10b981 !important;
        color: #fff;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
        animation: quiz-pop 0.4s ease;
    }

    .quiz-option.correct .quiz-option-letter {
        background: #10b981;
        color: #052e1f;
    }

    .quiz-option.correct .quiz-option-icon {
        color: #10b981;
    }

    /* Wrong State */
    .quiz-option.wrong {
        background: rgba(239, 68, 68, 0.12) !important;
        border-color: #ef4444 !important;
        color: #fca5a5;
        animation: quiz-shake 0.4s ease;
    }

    .quiz-option.wrong .quiz-option-letter {
        background: #ef4444;
        color: #2c0b0b;
    }

    .quiz-option.wrong .quiz-option-icon {
        color: #ef4444;
    }

    .quiz-option:disabled {
        cursor: default;
        opacity: 0.85;
    }

    @keyframes quiz-pop {
        0% { transform: scale(1); }
        35% { transform: scale(1.03); }
        100% { transform: scale(1); }
    }

    @keyframes quiz-shake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-5px); }
        40% { transform: translateX(5px); }
        60% { transform: translateX(-3px); }
        80% { transform: translateX(3px); }
    }
    
    .feedback {
        margin: 1.5rem 0;
        padding: 1.1rem 1.25rem;
        border-radius: 1rem;
        font-weight: 500;
        font-size: 1rem;
        line-height: 1.5;
        text-align: left;
        animation: fadeIn 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }
    
    .feedback.correct { 
        background: linear-gradient(90deg, rgba(34, 197, 94, 0.1), transparent); 
        color: #4ade80; 
        border-left: 4px solid #4ade80;
    }
    
    .feedback.wrong { 
        background: linear-gradient(90deg, rgba(239, 68, 68, 0.1), transparent); 
        color: #f87171;
        border-left: 4px solid #ef4444;
    }

    .score-ring {
        width: 150px;
        height: 150px;
        margin: 0.5rem auto 1.25rem;
        border-radius: 50%;
        display: flex;
        align-items: baseline;
        justify-content: center;
        background: radial-gradient(circle, rgba(34, 211, 238, 0.1), transparent 70%);
        border: 5px solid rgba(34, 211, 238, 0.25);
        box-shadow: 0 0 30px rgba(34, 211, 238, 0.2), inset 0 0 20px rgba(34, 211, 238, 0.08);
        animation: quiz-pop-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    #final-score {
        font-size: 3rem;
        font-weight: 800;
        background: linear-gradient(to bottom, var(--color-primary), var(--color-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .score-percent {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-primary);
        margin-left: 2px;
    }

    .reaction-text {
        font-size: 1.1rem;
        color: #cbd5e1;
    }
    
    .hidden { display: none !important; }
    
    #badge-notification {
        background: linear-gradient(160deg, rgba(34, 211, 238, 0.15), rgba(139, 92, 246, 0.15));
        border: 1px solid rgba(34, 211, 238, 0.5);
        box-shadow: 0 0 30px rgba(34, 211, 238, 0.15);
        border-radius: 1.25rem;
        padding: 2rem 1.5rem;
        margin: 2rem 0;
        animation: quiz-pop-in 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .badge-icon-animate {
        font-size: 5rem;
        line-height: 1;
        margin-bottom: 0.5rem;
        filter: drop-shadow(0 0 20px rgba(34, 211, 238, 0.6));
    }

    .badge-earned-label {
        margin: 0;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #a1a1aa;
    }

    .badge-earned-name {
        margin: 0.2rem 0 0.4rem 0;
        font-size: 1.4rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .badge-earned-desc {
        margin: 0;
        font-size: 0.9rem;
        color: #cbd5e1;
        line-height: 1.4;
    }
    
    @keyframes quiz-pop-in {
        0% { transform: scale(0.8); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
    
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
