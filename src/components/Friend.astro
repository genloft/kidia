---
interface Props {
  state?: 'idle' | 'talking' | 'thinking' | 'happy' | 'surprised' | 'glitch' | 'proud' | 'celebrating';
  mode?: 'avatar' | 'portrait' | 'full';
}

const { state = 'idle', mode = 'avatar' } = Astro.props;

// Un archivo de cuerpo entero por expresión (ilustraciones nuevas de la
// Dra. Vael). Los tres modos reutilizan la misma imagen; solo cambia el
// recorte/encuadre por CSS (ver object-fit/object-position más abajo).
const EXPRESSION_IMAGES: Record<string, string> = {
  idle: '/dravael-work.webp',
  talking: '/dravael-work.webp',
  thinking: '/dravael-doubt.webp',
  happy: '/dravael-ok.webp',
  proud: '/dravael-ok.webp',
  surprised: '/dravael-no.webp',
  glitch: '/dravael-no.webp',
  celebrating: '/dravael-dance.webp',
};
---

<div class={`friend-container mode-${mode} ${state}`} data-state={state}>
  <div class="friend-glow"></div>
  <img
    class="friend-sprite"
    src={EXPRESSION_IMAGES[state] || EXPRESSION_IMAGES.idle}
    alt="Dra. Vael"
  />
  <slot />
</div>

<script>
  // Cambia de expresión en respuesta a los eventos ya usados en el resto
  // del sitio (ver src/pages/scenario/[slug].astro).
  const EXPRESSION_IMAGES: Record<string, string> = {
    idle: '/dravael-work.webp',
    talking: '/dravael-work.webp',
    thinking: '/dravael-doubt.webp',
    happy: '/dravael-ok.webp',
    proud: '/dravael-ok.webp',
    surprised: '/dravael-no.webp',
    glitch: '/dravael-no.webp',
    celebrating: '/dravael-dance.webp',
  };

  const ACTION_TO_STATE: Record<string, string> = {
    smile: 'happy',
    happy: 'happy',
    think: 'thinking',
    dance: 'celebrating',
    celebrate: 'celebrating',
    surprise: 'surprised',
    glitch: 'glitch',
    gazapo: 'glitch',
    proud: 'proud',
    talk: 'talking',
    talking: 'talking',
  };

  window.addEventListener('kidia:action', (e) => {
    const { action } = (e as CustomEvent).detail;
    const nextState = ACTION_TO_STATE[action] || 'idle';

    document.querySelectorAll('.friend-container').forEach((container) => {
      const modeClass = Array.from(container.classList).find((c) => c.startsWith('mode-'));
      container.className = `friend-container ${modeClass || ''} ${nextState}`;
      container.setAttribute('data-state', nextState);

      const img = container.querySelector('.friend-sprite') as HTMLImageElement | null;
      if (img) img.src = EXPRESSION_IMAGES[nextState] || EXPRESSION_IMAGES.idle;
    });
  });
</script>

<style>
  .friend-container {
    position: relative;
    margin: 0 auto;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  /* Mode: Avatar (círculo, cabeza) */
  .friend-container.mode-avatar {
    width: 120px;
    height: 120px;
  }
  .friend-container.mode-avatar .friend-sprite {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 5%;
    border-radius: 50%;
    border: 3px solid var(--color-primary);
    background-color: #0f172a;
  }

  /* Mode: Portrait (medio cuerpo) */
  .friend-container.mode-portrait {
    width: 200px;
    height: 200px;
  }
  .friend-container.mode-portrait .friend-sprite {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.25));
  }

  /* Mode: Full (cuerpo entero) */
  .friend-container.mode-full {
    width: 260px;
    height: 440px;
  }
  .friend-container.mode-full .friend-sprite {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 15px rgba(34, 211, 238, 0.3));
  }

  .friend-container.mode-full .friend-glow,
  .friend-container.mode-portrait .friend-glow {
    display: none;
  }

  .friend-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.4) 0%, transparent 70%);
    animation: friend-pulse-glow 3s infinite;
    z-index: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  .friend-sprite {
    position: relative;
    z-index: 1;
  }

  /* Estados */
  .friend-container.talking .friend-sprite {
    animation: friend-talk-bounce 0.3s infinite alternate;
  }
  .friend-container.surprised .friend-sprite {
    animation: friend-shake 0.5s;
  }
  .friend-container.glitch .friend-sprite {
    filter: hue-rotate(90deg) contrast(1.5);
    animation: friend-glitch 0.2s infinite;
  }
  .friend-container.celebrating .friend-sprite {
    animation: friend-jump 0.5s infinite alternate;
  }

  @keyframes friend-talk-bounce {
    0% { transform: translateY(0); }
    100% { transform: translateY(-3px); }
  }

  @keyframes friend-pulse-glow {
    0%, 100% { opacity: 0.5; transform: scale(0.8); }
    50% { opacity: 0.8; transform: scale(1.1); }
  }

  @keyframes friend-shake {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(-10deg); }
    75% { transform: rotate(10deg); }
  }

  @keyframes friend-jump {
    0% { transform: translateY(0); }
    100% { transform: translateY(-10px); }
  }

  @keyframes friend-glitch {
    0% { transform: translate(0); }
    20% { transform: translate(-2px, 2px); }
    40% { transform: translate(2px, -2px); }
    60% { transform: translate(-2px, -2px); }
    80% { transform: translate(2px, 2px); }
    100% { transform: translate(0); }
  }
</style>
